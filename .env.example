# Copy to .env and fill in. .env is gitignored.

# Anthropic API key. Calls go directly to api.anthropic.com (x-api-key auth),
# matching the telex text path. The wpcom AI proxy is NOT used for Claude:
# the proxy does not accept the Anthropic key and the available proxy token
# (GOOGLE_VERTEX_API_TOKEN) is scoped to Google Vertex only. See PROGRESS.md.
ANTHROPIC_API_KEY=

# Default model for any site-creation step without a per-step override below.
LLM_MODEL=claude-opus-4-8

# Per-step model overrides (optional) — set any of these to A/B model quality,
# cost and speed for a single LLM step without touching code. Unset falls back
# to the per-step default in src/bootstrap.php (site-spec defaults to Haiku;
# theme-json and landing-page default to LLM_MODEL above). The other steps are
# deterministic and make no LLM calls.
#LLM_MODEL_SITE_SPEC=claude-haiku-4-5
# Design direction is the creative seed every later step builds on, so it
# defaults to LLM_MODEL (Opus). Drop to Haiku to trade some creativity for cost.
#LLM_MODEL_DESIGN_DIRECTION=claude-opus-4-8
#LLM_MODEL_THEME_JSON=claude-opus-4-8
#LLM_MODEL_SECTION_PLAN=claude-haiku-4-5
#LLM_MODEL_SECTIONS=claude-opus-4-8

# WPCOM AI proxy bearer token, scoped to Google Vertex. Used by the opt-in
# image-generation step (bin/build.php --with-images, bin/images.php) to turn
# the AI_IMAGE placeholders into real assets via Google Imagen. This is the one
# proxy route that works for the builder (see PROGRESS.md, Phase 0).
GOOGLE_VERTEX_API_TOKEN=

# Image model used through the proxy.
IMAGE_MODEL=imagen-4.0-generate-001

# Path to the "themer" design-knowledge repo. The sections step injects the
# matching design playbook (insights/sections/<part>.md) and a few real-theme
# few-shot examples (insights/examples.json) into every header/footer/section
# prompt. Optional: if this path is missing the loader returns empty strings and
# builds proceed unchanged. Default assumes the repo is checked out alongside.
THEMER_ROOT=/home/matias/dev/a8c/themer
