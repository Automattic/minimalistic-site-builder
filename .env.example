# Copy to .env and fill in. .env is gitignored.

# Which text/code LLM provider to use (default: config/models.json default_provider).
#   anthropic — Anthropic Messages API (ANTHROPIC_API_KEY)
#   xai       — OpenAI-compatible client → https://api.x.ai/v1 (XAI_API_KEY)
#   openai    — OpenAI-compatible client (OPENAI_API_KEY; optional OPENAI_BASE_URL)
# Picking a provider selects its whole model set (design/code/small tiers per step)
# from config/models.json — no need to set model ids by hand. The build CLI
# flag `--provider=<name>` does the same thing per run. Image generation is
# separate (GOOGLE_VERTEX_API_TOKEN below) and unaffected.
LLM_PROVIDER=anthropic

# Anthropic API key (LLM_PROVIDER=anthropic). Calls go directly to
# api.anthropic.com (x-api-key auth). The wpcom AI proxy is NOT used for Claude:
# the proxy does not accept the Anthropic key and the available proxy token
# (GOOGLE_VERTEX_API_TOKEN) is scoped to Google Vertex only. See PROGRESS.md.
ANTHROPIC_API_KEY=

# xAI API key (LLM_PROVIDER=xai). Bearer auth against api.x.ai Chat Completions.
#XAI_API_KEY=

# OpenAI (or any OpenAI-compatible host) when LLM_PROVIDER=openai.
#OPENAI_API_KEY=
# Optional base URL override (also used with LLM_PROVIDER=xai if you need a proxy).
#OPENAI_BASE_URL=https://api.openai.com/v1
# For xAI the default base is https://api.x.ai/v1 when LLM_PROVIDER=xai.

# Model tier overrides (optional). The provider above already supplies a
# design + code + small model per step (config/models.json). These let you
# override the tiers for a whole run without editing that file:
#   LLM_MODEL_DESIGN — the creative steps that decide what the site looks like
#                      (design-direction, its judge, theme-json)
#   LLM_MODEL_CODE   — the steps that emit block markup, CSS and PHP
#                      (sections, page-styles, custom-motion, fonts-php)
#   LLM_MODEL_SMALL  — the fast/cheap structural steps
#   LLM_MODEL        — design + code together, when you want one big model
# Leave unset to use the active provider's configured tiers.
#LLM_MODEL_DESIGN=claude-opus-5
#LLM_MODEL_CODE=claude-sonnet-5
#LLM_MODEL_SMALL=claude-haiku-4-5

# Per-step model overrides (optional) — set any of these to A/B model quality,
# cost and speed for a single LLM step without touching code. These beat the
# tier defaults above and accept any model id (from any provider — it must match
# the active LLM_PROVIDER's endpoint). Unset falls back to the step's tier in
# config/models.json. Deterministic steps make no LLM calls.
#LLM_MODEL_SITE_SPEC=claude-haiku-4-5
# Design direction is the creative seed every later step builds on, so it
# defaults to the design tier (Opus). Drop to Haiku to trade creativity for cost.
#LLM_MODEL_DESIGN_DIRECTION=claude-opus-5
# The judge that scores the candidate concept seeds and picks the one the
# direction is expanded from. Its reasoning lands in logs/llm/.
#LLM_MODEL_DESIGN_DIRECTION_JUDGE=claude-opus-5
#LLM_MODEL_THEME_JSON=claude-opus-5
#LLM_MODEL_PAGE_PLAN=claude-haiku-4-5
#LLM_MODEL_SECTIONS=claude-sonnet-5

# --- Switching providers ---
# The simplest path is just the provider — its per-step tiers come from
# config/models.json, so no per-step model vars are needed:
#   php bin/build.php "..." --provider=openai     # gpt-5.5 / gpt-5.4-mini tiers
#   php bin/build.php "..." --provider=xai         # grok-4.5 tiers
# Or set it here for every run:
#LLM_PROVIDER=openai
#OPENAI_API_KEY=
# Edit config/models.json to change which model each provider uses per tier.


# Sampling temperature (optional), same pattern as the model overrides:
# LLM_TEMPERATURE_<STEP> beats LLM_TEMPERATURE beats the per-step default in
# src/bootstrap.php (design-direction 1.0, sections 0.9, others unset = API
# default). Unset steps send no temperature at all. NOTE: the API removed
# sampling parameters on Claude Opus 4.7/4.8 and the whole Claude 5 family, so
# temperature only applies to steps running on models that still support it
# (Haiku 4.5, Sonnet 4.6, Opus <= 4.6); on the others the client omits it
# automatically. On the packaged anthropic defaults that means the seed call
# (Haiku) is the only one still sampling — which is where the design variety
# comes from anyway.
#LLM_TEMPERATURE=
#LLM_TEMPERATURE_DESIGN_DIRECTION=1.0
#LLM_TEMPERATURE_SECTIONS=0.9

# Force design-direction candidate N (1-based) instead of letting the judge
# pick — the reproducible-evals escape hatch. Skips the judge call entirely;
# out of range fails the build rather than drifting to another concept.
#DESIGN_DIRECTION_CHOICE=

# Force the header archetype instead of the random two-pick shortlist — same
# escape hatch. One of: standard-row, centered-masthead, minimal-overlay,
# oversized-wordmark, branded-lockup, double-decker, split-nav.
#HEADER_ARCHETYPE=

# WPCOM AI proxy bearer token, scoped to Google Vertex. Used by the opt-in
# image-generation step (bin/build.php --with-images, bin/images.php) to turn
# the AI_IMAGE placeholders into real assets via Google Imagen. This is the one
# proxy route that works for the builder (see PROGRESS.md, Phase 0).
GOOGLE_VERTEX_API_TOKEN=

# Image model used through the proxy.
IMAGE_MODEL=imagen-4.0-generate-001
