{
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "$id": "https://raw.githubusercontent.com/Automattic/minimalistic-site-builder/trunk/schemas/content-bundle.schema.json",
    "title": "SiteBuild content-only bundle",
    "description": "Version 1 delivery artifact produced by the approved-pattern composition for an existing WordPress theme.",
    "type": "object",
    "additionalProperties": false,
    "required": [
        "version",
        "kind",
        "input_hash",
        "requirements",
        "site",
        "brand",
        "pages",
        "shared_parts",
        "media"
    ],
    "properties": {
        "version": { "const": 1 },
        "kind": { "const": "wordpress-content" },
        "input_hash": { "$ref": "#/$defs/hash" },
        "requirements": {
            "type": "object",
            "additionalProperties": false,
            "required": ["theme"],
            "properties": {
                "theme": { "type": "string", "pattern": "^[a-z0-9][a-z0-9._-]*$" }
            }
        },
        "site": {
            "type": "object",
            "additionalProperties": false,
            "required": ["title"],
            "properties": {
                "title": { "type": "string", "minLength": 1 }
            }
        },
        "brand": {
            "type": "object",
            "additionalProperties": true
        },
        "pages": {
            "type": "array",
            "minItems": 1,
            "items": { "$ref": "#/$defs/content" }
        },
        "shared_parts": {
            "type": "array",
            "items": { "$ref": "#/$defs/sharedContent" }
        },
        "media": {
            "type": "array",
            "items": { "$ref": "#/$defs/media" }
        }
    },
    "$defs": {
        "hash": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$"
        },
        "content": {
            "type": "object",
            "additionalProperties": false,
            "required": ["id", "title", "slug", "content", "source_hash", "content_hash"],
            "properties": {
                "id": { "type": "string", "pattern": "^[a-z][a-z0-9-]*$" },
                "title": { "type": "string", "minLength": 1 },
                "slug": { "type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$" },
                "content": { "type": "string", "minLength": 1 },
                "source_hash": { "$ref": "#/$defs/hash" },
                "content_hash": { "$ref": "#/$defs/hash" }
            }
        },
        "sharedContent": {
            "type": "object",
            "additionalProperties": false,
            "required": ["id", "title", "slug", "content", "source_hash", "content_hash", "area"],
            "properties": {
                "id": { "type": "string", "pattern": "^[a-z][a-z0-9-]*$" },
                "title": { "type": "string", "minLength": 1 },
                "slug": { "type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$" },
                "content": { "type": "string", "minLength": 1 },
                "source_hash": { "$ref": "#/$defs/hash" },
                "content_hash": { "$ref": "#/$defs/hash" },
                "area": { "type": "string", "minLength": 1 }
            }
        },
        "media": {
            "type": "object",
            "additionalProperties": false,
            "required": ["source", "upload_path", "url", "title", "slug", "mime_type", "bytes", "sha256"],
            "properties": {
                "source": { "type": "string", "pattern": "^media/" },
                "upload_path": { "type": "string", "minLength": 1 },
                "url": { "type": "string", "format": "uri", "pattern": "^https?://" },
                "title": { "type": "string", "minLength": 1 },
                "slug": { "type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$" },
                "mime_type": { "type": "string", "pattern": "^image/" },
                "bytes": { "type": "integer", "minimum": 1 },
                "sha256": { "$ref": "#/$defs/hash" }
            }
        }
    }
}
