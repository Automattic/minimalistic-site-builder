{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://automattic.com/schemas/html-first-fidelity-report.schema.json",
  "title": "HTML-first control-versus-treatment fidelity report",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "generated_at",
    "rerun_command",
    "provenance",
    "projects",
    "totals"
  ],
  "properties": {
    "schema_version": {
      "const": 1
    },
    "generated_at": {
      "type": "string",
      "format": "date-time"
    },
    "rerun_command": {
      "const": "php bin/html-first-fidelity.php"
    },
    "provenance": {
      "$ref": "#/$defs/provenance"
    },
    "projects": {
      "type": "array",
      "minItems": 6,
      "maxItems": 6,
      "items": {
        "$ref": "#/$defs/project"
      }
    },
    "totals": {
      "$ref": "#/$defs/comparison"
    },
    "mark_metric_transition_audit": {
      "$ref": "#/$defs/markMetricTransitionAudit"
    }
  },
  "$defs": {
    "sha": {
      "type": "string",
      "pattern": "^[0-9a-f]{40}$"
    },
    "sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "hashMap": {
      "type": "object",
      "minProperties": 2,
      "propertyNames": {
        "pattern": "^(?:[^/]+/)*(?:[^/]+\\.html|site\\.css)$"
      },
      "additionalProperties": {
        "$ref": "#/$defs/sha256"
      }
    },
    "provenanceSide": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "site_builder_ref",
        "site_builder_sha",
        "transformer_label",
        "transformer_reference",
        "transformer_version",
        "transformer_installed_tree_sha256"
      ],
      "properties": {
        "site_builder_ref": {
          "type": "string",
          "minLength": 1
        },
        "site_builder_sha": {
          "$ref": "#/$defs/sha"
        },
        "transformer_label": {
          "type": "string",
          "minLength": 1
        },
        "transformer_reference": {
          "type": "string",
          "minLength": 1
        },
        "transformer_version": {
          "type": "string",
          "minLength": 1
        },
        "transformer_installed_tree_sha256": {
          "description": "SHA-256 of the installed control transformer relative-path-to-byte-SHA map.",
          "$ref": "#/$defs/sha256"
        }
      }
    },
    "treatmentProvenanceSide": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "site_builder_ref",
        "site_builder_sha",
        "transformer_label",
        "transformer_reference",
        "transformer_version",
        "transformer_commit_sha",
        "transformer_git_subtree_oid",
        "transformer_installed_tree_sha256"
      ],
      "properties": {
        "site_builder_ref": {
          "type": "string",
          "minLength": 1
        },
        "site_builder_sha": {
          "$ref": "#/$defs/sha"
        },
        "transformer_label": {
          "type": "string",
          "minLength": 1
        },
        "transformer_reference": {
          "type": "string",
          "minLength": 1
        },
        "transformer_version": {
          "type": "string",
          "minLength": 1
        },
        "transformer_commit_sha": {
          "description": "Full overlay repository commit resolved from HEAD for this run.",
          "$ref": "#/$defs/sha"
        },
        "transformer_git_subtree_oid": {
          "description": "Git tree object ID for php-transformer at transformer_commit_sha.",
          "$ref": "#/$defs/sha"
        },
        "transformer_installed_tree_sha256": {
          "description": "SHA-256 of the installed php-transformer relative-path-to-byte-SHA map.",
          "$ref": "#/$defs/sha256"
        }
      }
    },
    "provenance": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "source_projects",
        "control",
        "treatment"
      ],
      "properties": {
        "source_projects": {
          "type": "string",
          "minLength": 1
        },
        "control": {
          "$ref": "#/$defs/provenanceSide"
        },
        "treatment": {
          "$ref": "#/$defs/treatmentProvenanceSide"
        }
      }
    },
    "designInputs": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "control_before",
        "treatment_before",
        "control_after",
        "treatment_after",
        "identical_before",
        "control_unchanged",
        "treatment_unchanged"
      ],
      "properties": {
        "control_before": {
          "$ref": "#/$defs/hashMap"
        },
        "treatment_before": {
          "$ref": "#/$defs/hashMap"
        },
        "control_after": {
          "$ref": "#/$defs/hashMap"
        },
        "treatment_after": {
          "$ref": "#/$defs/hashMap"
        },
        "identical_before": {
          "type": "boolean"
        },
        "control_unchanged": {
          "type": "boolean"
        },
        "treatment_unchanged": {
          "type": "boolean"
        }
      }
    },
    "resume": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "exit_code",
        "llm_requests"
      ],
      "properties": {
        "exit_code": {
          "type": "integer",
          "minimum": 0
        },
        "llm_requests": {
          "type": "integer",
          "minimum": 0
        }
      }
    },
    "layoutValue": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "value",
        "unitless"
      ],
      "properties": {
        "value": {
          "type": [
            "string",
            "number",
            "null"
          ]
        },
        "unitless": {
          "type": "boolean"
        }
      }
    },
    "engineMarkers": {
      "type": "object",
      "propertyNames": {
        "enum": [
          "blocks-engine-synthetic-paragraph",
          "blocks-engine-synthetic-anchor-undecorated",
          "blocks-engine-inline-layout-carrier",
          "blocks-engine-css-owned-flow",
          "blocks-engine-css-owned-grid",
          "blocks-engine-css-owned-layout",
          "blocks-engine-css-owned-layout-item",
          "blocks-engine-empty-flex-item",
          "blocks-engine-control",
          "blocks-engine-list-navigation",
          "richtext-marker"
        ]
      },
      "additionalProperties": {
        "type": "integer",
        "minimum": 1
      }
    },
    "metrics": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "empty_buttons",
        "marks_without_background_color",
        "align_wide",
        "layout",
        "unmatched_engine_markers",
        "unmatched_engine_marker_occurrences"
      ],
      "properties": {
        "empty_buttons": {
          "type": "integer",
          "minimum": 0
        },
        "marks_without_background_color": {
          "description": "Count <mark> start tags whose inline style has no background-color declaration unless the tag carries --blocks-engine-richtext-marker:<token> and matching engine marker CSS declares background-color.",
          "type": "integer",
          "minimum": 0
        },
        "align_wide": {
          "type": "integer",
          "minimum": 0
        },
        "layout": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "content_size",
            "wide_size"
          ],
          "properties": {
            "content_size": {
              "$ref": "#/$defs/layoutValue"
            },
            "wide_size": {
              "$ref": "#/$defs/layoutValue"
            }
          }
        },
        "unmatched_engine_markers": {
          "$ref": "#/$defs/engineMarkers"
        },
        "unmatched_engine_marker_occurrences": {
          "type": "integer",
          "minimum": 0
        }
      }
    },
    "side": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "resume",
        "metrics"
      ],
      "properties": {
        "resume": {
          "$ref": "#/$defs/resume"
        },
        "metrics": {
          "$ref": "#/$defs/metrics"
        }
      }
    },
    "countTotals": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "empty_buttons",
        "marks_without_background_color",
        "align_wide",
        "unmatched_engine_marker_occurrences"
      ],
      "properties": {
        "empty_buttons": {
          "type": "integer"
        },
        "marks_without_background_color": {
          "description": "Corrected marker-aware mark defect count; totals and deltas use the same semantics as metrics.marks_without_background_color.",
          "type": "integer"
        },
        "align_wide": {
          "type": "integer"
        },
        "unmatched_engine_marker_occurrences": {
          "type": "integer"
        }
      }
    },
    "markMetricCountPair": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "legacy",
        "corrected"
      ],
      "properties": {
        "legacy": {
          "type": "integer",
          "minimum": 0
        },
        "corrected": {
          "type": "integer",
          "minimum": 0
        }
      }
    },
    "markMetricTransitionProject": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "slug",
        "control",
        "treatment"
      ],
      "properties": {
        "slug": {
          "enum": [
            "silver-summit",
            "swift-grove",
            "sunny-ember",
            "calm-lantern",
            "azure-garden",
            "amber-ember"
          ]
        },
        "control": {
          "$ref": "#/$defs/markMetricCountPair"
        },
        "treatment": {
          "$ref": "#/$defs/markMetricCountPair"
        }
      }
    },
    "markMetricTransitionTotals": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "control",
        "treatment"
      ],
      "properties": {
        "control": {
          "$ref": "#/$defs/markMetricCountPair"
        },
        "treatment": {
          "$ref": "#/$defs/markMetricCountPair"
        }
      }
    },
    "markMetricTransitionAudit": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "legacy_definition",
        "corrected_definition",
        "projects",
        "totals"
      ],
      "properties": {
        "legacy_definition": {
          "const": "Count <mark> start tags whose inline style has no background-color declaration."
        },
        "corrected_definition": {
          "const": "Count <mark> start tags whose inline style has no background-color declaration unless the tag carries --blocks-engine-richtext-marker:<token> and matching engine marker CSS declares background-color."
        },
        "projects": {
          "type": "array",
          "minItems": 6,
          "maxItems": 6,
          "items": {
            "$ref": "#/$defs/markMetricTransitionProject"
          }
        },
        "totals": {
          "$ref": "#/$defs/markMetricTransitionTotals"
        }
      }
    },
    "comparison": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "control",
        "treatment",
        "delta"
      ],
      "properties": {
        "control": {
          "$ref": "#/$defs/countTotals"
        },
        "treatment": {
          "$ref": "#/$defs/countTotals"
        },
        "delta": {
          "$ref": "#/$defs/countTotals"
        }
      }
    },
    "project": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "slug",
        "design_inputs",
        "control",
        "treatment",
        "delta"
      ],
      "properties": {
        "slug": {
          "enum": [
            "silver-summit",
            "swift-grove",
            "sunny-ember",
            "calm-lantern",
            "azure-garden",
            "amber-ember"
          ]
        },
        "design_inputs": {
          "$ref": "#/$defs/designInputs"
        },
        "control": {
          "$ref": "#/$defs/side"
        },
        "treatment": {
          "$ref": "#/$defs/side"
        },
        "delta": {
          "$ref": "#/$defs/countTotals"
        }
      }
    }
  }
}
