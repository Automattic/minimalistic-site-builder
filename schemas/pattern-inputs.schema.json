{
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "$id": "https://raw.githubusercontent.com/Automattic/minimalistic-site-builder/trunk/schemas/pattern-inputs.schema.json",
    "title": "SiteBuild approved-pattern inputs",
    "description": "Version 1 inputs for SiteBuilder::createPatternProject(). Layout and style bytes are approved source; only explicitly declared content slots may change.",
    "type": "object",
    "additionalProperties": false,
    "required": ["version", "facts", "brand", "delivery", "media", "layouts"],
    "properties": {
        "version": { "const": 1 },
        "facts": {
            "type": "object",
            "description": "Caller-approved facts available to deterministic bindings and content generation.",
            "additionalProperties": true
        },
        "brand": {
            "type": "object",
            "description": "Fixed caller-owned Brand values carried unchanged into the content bundle.",
            "additionalProperties": true
        },
        "delivery": {
            "type": "object",
            "additionalProperties": false,
            "required": ["theme", "site_title"],
            "properties": {
                "theme": {
                    "type": "string",
                    "pattern": "^[a-z0-9][a-z0-9._-]*$",
                    "description": "Slug of an existing destination theme."
                },
                "site_title": { "type": "string", "minLength": 1 }
            }
        },
        "media": {
            "type": "array",
            "items": { "$ref": "#/$defs/media" }
        },
        "layouts": {
            "type": "array",
            "minItems": 1,
            "items": { "$ref": "#/$defs/layout" },
            "contains": {
                "type": "object",
                "properties": { "role": { "const": "page" } },
                "required": ["role"]
            },
            "minContains": 1
        }
    },
    "$defs": {
        "placement": {
            "type": "object",
            "additionalProperties": false,
            "required": ["title", "slug"],
            "properties": {
                "title": { "type": "string", "minLength": 1 },
                "slug": {
                    "type": "string",
                    "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
                }
            }
        },
        "sharedPlacement": {
            "type": "object",
            "additionalProperties": false,
            "required": ["title", "slug", "area"],
            "properties": {
                "title": { "type": "string", "minLength": 1 },
                "slug": {
                    "type": "string",
                    "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
                },
                "area": { "type": "string", "minLength": 1 }
            }
        },
        "slot": {
            "type": "object",
            "additionalProperties": false,
            "required": ["id", "block_path", "field", "fallback"],
            "properties": {
                "id": { "type": "string", "pattern": "^[a-z][a-z0-9-]*$" },
                "block_path": {
                    "type": "array",
                    "minItems": 1,
                    "items": { "type": "integer", "minimum": 0 }
                },
                "field": { "enum": ["text", "strong-text", "url", "alt", "citation"] },
                "fallback": { "type": "string" },
                "binding": { "type": "string", "minLength": 1 },
                "instruction": { "type": "string" },
                "max_words": { "type": "integer", "minimum": 1 }
            },
            "allOf": [
                {
                    "if": { "properties": { "field": { "const": "url" } }, "required": ["field"] },
                    "then": { "required": ["binding"] }
                }
            ]
        },
        "layout": {
            "type": "object",
            "additionalProperties": false,
            "required": ["id", "role", "markup", "slots"],
            "properties": {
                "id": { "type": "string", "pattern": "^[a-z][a-z0-9-]*$" },
                "role": { "enum": ["page", "shared-part"] },
                "markup": { "type": "string", "minLength": 1 },
                "slots": {
                    "type": "array",
                    "items": { "$ref": "#/$defs/slot" }
                },
                "page": { "$ref": "#/$defs/placement" },
                "shared_part": { "$ref": "#/$defs/sharedPlacement" }
            },
            "oneOf": [
                {
                    "properties": { "role": { "const": "page" } },
                    "required": ["page"],
                    "not": { "required": ["shared_part"] }
                },
                {
                    "properties": { "role": { "const": "shared-part" } },
                    "required": ["shared_part"],
                    "not": { "required": ["page"] }
                }
            ]
        },
        "media": {
            "type": "object",
            "additionalProperties": false,
            "required": ["source", "upload_path", "url", "title", "slug", "mime_type"],
            "properties": {
                "source": {
                    "type": "string",
                    "pattern": "^media/(?!.*(?:^|/)\\.\\.?/)[^\\\\*]+$",
                    "description": "Project-relative source file included beside the bundle."
                },
                "upload_path": {
                    "type": "string",
                    "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.?/)[^\\\\*]+$"
                },
                "url": { "type": "string", "format": "uri", "pattern": "^https?://" },
                "title": { "type": "string", "minLength": 1 },
                "slug": { "type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$" },
                "mime_type": { "type": "string", "pattern": "^image/" }
            }
        }
    }
}
