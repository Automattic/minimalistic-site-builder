<group tag="section">
  <group padding="large"><heading level="2">Compliance, Before and After Bayshore.</heading></group>
  <columns gap="small">
    <column justify="center" gap="medium">
      <heading level="3">Without Bayshore</heading>
      <group gap="small" layout="stack" size="grow">
        <text>Hunt the right policy, fill the right form, wait</text>
        <text>Experts chase context across point solutions and docs</text>
        <text>Same question, different answer per reviewer</text>
        <text>Reasoning scattered across inboxes and PDFs</text>
        <text>Capacity grows only with headcount</text>
      </group>
    </column>
    <column justify="center" gap="medium">
      <image aspect-ratio="2043/1440" query="Sculptural stone landscape"/>
      <heading level="3">With Bayshore</heading>
      <group gap="small" layout="stack" size="grow">
        <text>Ask one front door, get an instant answer</text>
        <text>Agents gather context from existing solutions automatically</text>
        <text>Same case, same logic, every time</text>
        <text>Every decision documented with a full audit trail</text>
        <text>One platform scales without scaling the team</text>
      </group>
    </column>
  </columns>
</group>
