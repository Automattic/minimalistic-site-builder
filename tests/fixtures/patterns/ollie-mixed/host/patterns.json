      "content": "<!-- wp:group {\"metadata\":{\"name\":\"Features With Emojis\"},\"align\":\"full\",\"style\":{\"spacing\":{\"padding\":{\"top\":\"var:preset|spacing|xx-large\",\"bottom\":\"var:preset|spacing|xx-large\",\"left\":\"var:preset|spacing|medium\",\"right\":\"var:preset|spacing|medium\"},\"margin\":{\"top\":\"0\",\"bottom\":\"0\"},\"blockGap\":\"var:preset|spacing|large\"}},\"backgroundColor\":\"primary\",\"textColor\":\"base\",\"layout\":{\"type\":\"constrained\"}} -->\n\t<div class=\"wp-block-group alignfull has-base-color has-primary-background-color has-text-color has-background\" style=\"margin-top:0;margin-bottom:0;padding-top:var(--wp--preset--spacing--xx-large);padding-right:var(--wp--preset--spacing--medium);padding-bottom:var(--wp--preset--spacing--xx-large);padding-left:var(--wp--preset--spacing--medium)\">\n\t<!-- wp:group {\"align\":\"wide\",\"style\":{\"spacing\":{\"blockGap\":\"var:preset|spacing|large\"}},\"layout\":{\"type\":\"grid\",\"minimumColumnWidth\":\"29rem\"}} -->\n\t\t<div class=\"wp-block-group alignwide\">\n\t\t<!-- wp:group {\"metadata\":{\"name\":\"Feature\"},\"style\":{\"spacing\":{\"blockGap\":\"var:preset|spacing|small\"}},\"layout\":{\"type\":\"constrained\"}} -->\n\t\t\t<div class=\"wp-block-group\">\n\t\t\t<!-- wp:paragraph {\"fontSize\":\"large\"} -->\n\t\t\t\t<p class=\"has-large-font-size\">😍</p>\n\t\t\t<!-- /wp:paragraph -->\n\t\t\t<!-- wp:heading {\"level\":3} -->\n\t\t\t\t<h3 class=\"wp-block-heading\">Ollie Patterns</h3>\n\t\t\t<!-- /wp:heading -->\n\t\t\t<!-- wp:paragraph {\"textColor\":\"primary-accent\"} -->\n\t\t\t\t<p class=\"has-primary-accent-color has-text-color\">Ollie ships with over twenty beautiful pattern designs you can use to build a stunning and powerful website. Easily drag and drop patterns to create a design and hit publish!</p>\n\t\t\t<!-- /wp:paragraph -->\n\t\t\t</div>\n\t\t<!-- /wp:group -->\n\t\t<!-- wp:group {\"metadata\":{\"name\":\"Feature\"},\"style\":{\"spacing\":{\"blockGap\":\"var:preset|spacing|small\"}},\"layout\":{\"type\":\"constrained\"}} -->\n\t\t\t<div class=\"wp-block-group\">\n\t\t\t<!-- wp:paragraph {\"fontSize\":\"large\"} -->\n\t\t\t\t<p class=\"has-large-font-size\">😎</p>\n\t\t\t<!-- /wp:paragraph -->\n\t\t\t<!-- wp:heading {\"level\":3} -->\n\t\t\t\t<h3 class=\"wp-block-heading\">Ollie Templates</h3>\n\t\t\t<!-- /wp:heading -->\n\t\t\t<!-- wp:paragraph {\"textColor\":\"primary-accent\"} -->\n\t\t\t\t<p class=\"has-primary-accent-color has-text-color\">Ollie ships with over ten professionally-designed page templates (About, Profile, Download, etc.) so you can get your site off the ground in no time.</p>\n\t\t\t<!-- /wp:paragraph -->\n\t\t\t</div>\n\t\t<!-- /wp:group -->\n\t\t<!-- wp:group {\"metadata\":{\"name\":\"Feature\"},\"style\":{\"spacing\":{\"blockGap\":\"var:preset|spacing|small\"}},\"layout\":{\"type\":\"constrained\"}} -->\n\t\t\t<div class=\"wp-block-group\">\n\t\t\t<!-- wp:paragraph {\"fontSize\":\"large\"} -->\n\t\t\t\t<p class=\"has-large-font-size\">🤓</p>\n\t\t\t<!-- /wp:paragraph -->\n\t\t\t<!-- wp:heading {\"level\":3} -->\n\t\t\t\t<h3 class=\"wp-block-heading\">Ollie Block Theme</h3>\n\t\t\t<!-- /wp:heading -->\n\t\t\t<!-- wp:paragraph {\"textColor\":\"primary-accent\"} -->\n\t\t\t\t<p class=\"has-primary-accent-color has-text-color\">Build your entire site visually in WordPress with a powerful drag and drop page builder. No costly plugins or coding skills required! WordPress has never looked so good.</p>\n\t\t\t<!-- /wp:paragraph -->\n\t\t\t</div>\n\t\t<!-- /wp:group -->\n\t\t<!-- wp:group {\"metadata\":{\"name\":\"Feature\"},\"style\":{\"spacing\":{\"blockGap\":\"var:preset|spacing|small\"}},\"layout\":{\"type\":\"constrained\"}} -->\n\t\t\t<div class=\"wp-block-group\">\n\t\t\t<!-- wp:paragraph {\"fontSize\":\"large\"} -->\n\t\t\t\t<p class=\"has-large-font-size\">🤣</p>\n\t\t\t<!-- /wp:paragraph -->\n\t\t\t<!-- wp:heading {\"level\":3} -->\n\t\t\t\t<h3 class=\"wp-block-heading\">Ollie Onboarding</h3>\n\t\t\t<!-- /wp:heading -->\n\t\t\t<!-- wp:paragraph {\"textColor\":\"primary-accent\"} -->\n\t\t\t\t<p class=\"has-primary-accent-color has-text-color\">Setting up a new site can be a pain! The Ollie Site Wizard takes care of those annoying setup steps and configures your site with a few clicks instead.</p>\n\t\t\t<!-- /wp:paragraph -->\n\t\t\t</div>\n\t\t<!-- /wp:group -->\n\t\t</div>\n\t<!-- /wp:group -->\n\t</div>\n<!-- /wp:group -->"
    },
