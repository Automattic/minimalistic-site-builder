      "content": "<!-- wp:group {\"metadata\":{\"name\":\"Contact Details\"},\"align\":\"full\",\"style\":{\"spacing\":{\"margin\":{\"top\":\"0px\",\"bottom\":\"0px\"},\"padding\":{\"top\":\"var:preset|spacing|xx-large\",\"bottom\":\"var:preset|spacing|xx-large\",\"right\":\"var:preset|spacing|medium\",\"left\":\"var:preset|spacing|medium\"}}},\"layout\":{\"inherit\":true,\"type\":\"constrained\"}} -->\n\t<div class=\"wp-block-group alignfull\" style=\"margin-top:0px;margin-bottom:0px;padding-top:var(--wp--preset--spacing--xx-large);padding-right:var(--wp--preset--spacing--medium);padding-bottom:var(--wp--preset--spacing--xx-large);padding-left:var(--wp--preset--spacing--medium)\">\n\t<!-- wp:columns {\"verticalAlignment\":\"center\",\"align\":\"wide\",\"style\":{\"spacing\":{\"blockGap\":{\"top\":\"var:preset|spacing|x-large\",\"left\":\"var:preset|spacing|x-large\"},\"margin\":{\"top\":\"0px\",\"bottom\":\"0px\"}}}} -->\n\t\t<div class=\"wp-block-columns alignwide are-vertically-aligned-center\" style=\"margin-top:0px;margin-bottom:0px\">\n\t\t<!-- wp:column {\"verticalAlignment\":\"center\"} -->\n\t\t\t<div class=\"wp-block-column is-vertically-aligned-center\">\n\t\t\t<!-- wp:group {\"metadata\":{\"name\":\"Text\"},\"style\":{\"spacing\":{\"blockGap\":\"var:preset|spacing|small\"}},\"layout\":{\"type\":\"constrained\"}} -->\n\t\t\t\t<div class=\"wp-block-group\">\n\t\t\t\t<!-- wp:paragraph {\"style\":{\"typography\":{\"fontStyle\":\"normal\",\"fontWeight\":\"500\"}},\"textColor\":\"primary\",\"fontSize\":\"small\"} -->\n\t\t\t\t\t<p class=\"has-primary-color has-text-color has-small-font-size\" style=\"font-style:normal;font-weight:500\">Contact Us</p>\n\t\t\t\t<!-- /wp:paragraph -->\n\t\t\t\t<!-- wp:heading -->\n\t\t\t\t\t<h2 class=\"wp-block-heading\">Give us a ring, we&apos;d love to chat with you.</h2>\n\t\t\t\t<!-- /wp:heading -->\n\t\t\t\t<!-- wp:paragraph -->\n\t\t\t\t\t<p>Whether you&apos;re looking for a brand refresh, a new web presence, or are curious about consultation, please drop us a line and let&apos;s start a blossoming relationship!</p>\n\t\t\t\t<!-- /wp:paragraph -->\n\t\t\t\t</div>\n\t\t\t<!-- /wp:group -->\n\t\t\t<!-- wp:buttons {\"style\":{\"spacing\":{\"blockGap\":\"var:preset|spacing|small\"}}} -->\n\t\t\t\t<div class=\"wp-block-buttons\">\n\t\t\t\t<!-- wp:button {\"className\":\"is-style-fill\"} -->\n\t\t\t\t\t<div class=\"wp-block-button is-style-fill\"><a class=\"wp-block-button__link wp-element-button\">Contact Us</a></div>\n\t\t\t\t<!-- /wp:button -->\n\t\t\t\t<!-- wp:button {\"className\":\"is-style-secondary-button\"} -->\n\t\t\t\t\t<div class=\"wp-block-button is-style-secondary-button\"><a class=\"wp-block-button__link wp-element-button\">Join Our Team</a></div>\n\t\t\t\t<!-- /wp:button -->\n\t\t\t\t</div>\n\t\t\t<!-- /wp:buttons -->\n\t\t\t<!-- wp:separator {\"className\":\"is-style-separator-thin\",\"style\":{\"spacing\":{\"margin\":{\"top\":\"var:preset|spacing|large\",\"bottom\":\"var:preset|spacing|large\"}}},\"backgroundColor\":\"border-light\"} -->\n\t\t\t\t<hr class=\"wp-block-separator has-text-color has-border-light-color has-alpha-channel-opacity has-border-light-background-color has-background is-style-separator-thin\" style=\"margin-top:var(--wp--preset--spacing--large);margin-bottom:var(--wp--preset--spacing--large)\"/>\n\t\t\t<!-- /wp:separator -->\n\t\t\t<!-- wp:group {\"metadata\":{\"name\":\"Testimonial\"},\"style\":{\"spacing\":{\"blockGap\":\"var:preset|spacing|small\"}},\"layout\":{\"type\":\"constrained\"}} -->\n\t\t\t\t<div class=\"wp-block-group\">\n\t\t\t\t<!-- wp:paragraph {\"textColor\":\"primary\"} -->\n\t\t\t\t\t<p class=\"has-primary-color has-text-color\">★★★★★</p>\n\t\t\t\t<!-- /wp:paragraph -->\n\t\t\t\t<!-- wp:paragraph {\"style\":{\"typography\":{\"fontStyle\":\"normal\",\"fontWeight\":\"600\"}}} -->\n\t\t\t\t\t<p style=\"font-style:normal;font-weight:600\">&quot;Working with Ollie has been a delight from start to finish.&quot;</p>\n\t\t\t\t<!-- /wp:paragr