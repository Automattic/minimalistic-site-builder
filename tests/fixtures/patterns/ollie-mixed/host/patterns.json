"metadata\":{\"name\":\"Titles\"},\"style\":{\"spacing\":{\"blockGap\":\"var:preset|spacing|small\"}},\"layout\":{\"type\":\"constrained\"}} -->\n\t\t\t\t<div class=\"wp-block-group\">\n\t\t\t\t<!-- wp:paragraph {\"align\":\"center\",\"style\":{\"typography\":{\"fontStyle\":\"normal\",\"fontWeight\":\"500\"}},\"textColor\":\"main-accent\",\"fontSize\":\"small\"} -->\n\t\t\t\t\t<p class=\"has-text-align-center has-main-accent-color has-text-color has-small-font-size\" style=\"font-style:normal;font-weight:500\">WordPress Reimagined</p>\n\t\t\t\t<!-- /wp:paragraph -->\n\t\t\t\t<!-- wp:heading {\"textAlign\":\"center\",\"level\":1,\"className\":\"has-secondary-font-family\",\"style\":{\"typography\":{\"fontSize\":\"4rem\"}}} -->\n\t\t\t\t\t<h1 class=\"wp-block-heading has-text-align-center has-secondary-font-family\" style=\"font-size:4rem\">Build your site with clicks, not code.</h1>\n\t\t\t\t<!-- /wp:heading -->\n\t\t\t\t</div>\n\t\t\t<!-- /wp:group -->\n\t\t\t<!-- wp:paragraph {\"align\":\"center\",\"textColor\":\"main-accent\"} -->\n\t\t\t\t<p class=\"has-text-align-center has-main-accent-color has-text-color\">Easily create beautiful, fully-customizable websites with the new WordPress Site Editor and the Ollie block theme. No coding skills required.</p>\n\t\t\t<!-- /wp:paragraph -->\n\t\t\t<!-- wp:buttons {\"style\":{\"spacing\":{\"blockGap\":\"var:preset|spacing|small\"}},\"layout\":{\"type\":\"flex\",\"justifyContent\":\"center\"}} -->\n\t\t\t\t<div class=\"wp-block-buttons\">\n\t\t\t\t<!-- wp:button {\"className\":\"is-style-button-brand\"} -->\n\t\t\t\t\t<div class=\"wp-block-button is-style-button-brand\"><a class=\"wp-block-button__link wp-element-button\">Download Ollie</a></div>\n\t\t\t\t<!-- /wp:button -->\n\t\t\t\t<!-- wp:button {\"className\":\"is-style-button-light\"} -->\n\t\t\t\t\t<div class=\"wp-block-button is-style-button-light\"><a class=\"wp-block-button__link wp-element-button\">Ollie Features</a></div>\n\t\t\t\t<!-- /wp:button -->\n\t\t\t\t</d