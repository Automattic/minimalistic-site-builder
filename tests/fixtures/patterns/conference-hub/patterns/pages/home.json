\t\t\t<p class=\"has-text-align-left\" style=\"line-height:0.6;text-transform:uppercase;writing-mode:vertical-rl\">Early Bird</p>\n\t\t\t\t<!-- /wp:paragraph -->\n\t\t\t</div>\n\t\t\t<!-- /wp:group -->\n\t\t</div>\n\t\t<!-- /wp:column -->\n\t</div>\n\t<!-- /wp:columns -->\n\n\t<!-- wp:columns {\"align\":\"full\",\"className\":\"is-style-section-2\",\"style\":{\"spacing\":{\"blockGap\":{\"top\":\"0\",\"left\":\"0\"},\"padding\":{\"top\":\"0\",\"bottom\":\"0\"}}}} -->\n\t<div class=\"wp-block-columns alignfull is-style-section-2\" style=\"padding-top:0;padding-bottom:0\">\n\t\t<!-- wp:column {\"width\":\"50%\"} -->\n\t\t<div class=\"wp-block-column\" style=\"flex-basis:50%\">\n\t\t\t<!-- wp:group {\"style\":{\"spacing\":{\"blockGap\":\"var:preset|spacing|20\",\"padding\":{\"top\":\"var:preset|spacing|50\",\"bottom\":\"var:preset|spacing|50\",\"left\":\"var:preset|spacing|50\",\"right\":\"var:preset|spacing|50\"}},\"dimensions\":{\"minHeight\":\"33vh\"}},\"layout\":{\"type\":\"flex\",\"orientation\":\"vertical\",\"justifyContent\":\"stretch\",\"verticalAlignment\":\"space-between\"}} -->\n\t\t\t<div class=\"wp-block-group\" style=\"min-height:33vh;padding-top:var(--wp--preset--spacing--50);padding-right:var(--wp--preset--spacing--50);padding-bottom:var(--wp--preset--spacing--50);padding-left:var(--wp--preset--spacing--50)\">\n\t\t\t\t<!-- wp:paragraph -->\n\t\t\t\t<p>Three days of curated keynotes, hands-on workshops, and deep-dive roundtables built for events teams who run multi-track programs. Walk away with playbooks, not just notes.</p>\n\t\t\t\t<!-- /wp:paragraph -->\n\n\t\t\t\t<!-- wp:spacer {\"height\":\"0px\",\"style\":{\"layout\":{\"flexSize\":\"100px\",\"selfStretch\":\"fixed\"}}} -->\n\t\t\t\t<div style=\"height:0px\" aria-hidden=\"true\" class=\"wp-block-spacer\"></div>\n\t\t\t\t<!-- /wp:spacer -->\n\n\t\t\t\t<!-- wp:heading {\"fontSize\":\"xx-large\"} -->\n\t\t\t\t<h2 class=\"wp-block-heading has-xx-large-font-size\"><a href=\"#\">Register</a></h2>\n\t\t\t\t<!-- /wp:heading -->\n\t\t\t</div>\n\t\t\t<!-- /wp:group -->\n\t\t</div>\n\t\t<!-- /wp:column -->\n\n\t\t<!-- wp:column {\"width\":\"50%\"} -->\n\t\t<div class=\"wp-block-column\" style=\"flex-basis:50%\">\n\t\t\t<!-- wp:cover {\"url\":\"/wp-content/themes/twentytwentyfive/assets/images/botany-flowers-closeup.webp\",\"dimRatio\":0,\"isDark\":false} -->\n\t\t\t<div class=\"wp-block-cover is-light\"><span aria-hidden=\"true\" class=\"wp-block-cover__background has-background-dim-0 has-background-dim\"></span><img class=\"wp-block-cover__image-background\" alt=\"Close up photo of white flowers on a grey background\" src=\"/wp-content/themes/twentytwentyfive/assets/images/botany-flowers-closeup.webp\" data-object-fit=\"cover\"/>\n\t\t\t<div class=\"wp-block-cover__inner-container\">\n\t\t\t\t<!-- wp:spacer {\"height\":\"var:preset|spacing|20\"} -->\n\t\t\t\t<div style=\"height:var(--wp--preset--spacing--20)\" aria-hidden=\"true\" class=\"wp-block-spacer\"></div>\n\t\t\t\t<!-- /wp:spacer -->\n\t\t\t</div></div>\n\t\t\t<!-- /wp:cover -->\n\t\t</div>\n\t\t<!-- /wp:column -->\n\t</div>\n\t<!-- /wp:columns -->\n</div>\n<!-- /wp:group -->\n\n<!-- wp:group {\"align\":\"full\",\"className\":\"is-style-section-3\",\"style\":{\"spacing\":{\"padding\":{\"top\":\"var:preset|spacing|50\",\"bottom\":\"var:preset|spacing|50\"},\"margin\":{\"top\":\"0\",\"bottom\":\"0\"}}},\"layout\":{\"type\":\"constrained\"}} -->\n<div class=\"wp-block-group alignfull is-style-section-3\" style=\"margin-top:0;margin-bottom:0;padding-top:var(--wp--preset--spacing--50);padding-bottom:var(--wp--preset--spacing--50)\">\n\t<!-- wp:group {\"align\":\"wide\",\"style\":{\"spacing\":{}},\"layout\":{\"type\":\"constrained\"}} -->\n\t<div class=\"wp-block-group alignwide\">\n\t\t<!-- wp:image {\"sizeSlug\":\"full\",\"linkDestination\":\"none\",\"align\":\"wide\"} -->\n\t\t<figure class=\"wp-block-image alignwide size-full\">\n\t\t\t<img src=\"/wp-content/themes/twentytwentyfive/assets/images/coming-soon-bg-image.webp\" alt=\"Photo of a field full of flowers, a blue sky and a tree.\"/>\n\t\t</figure>\n\t\t<!-- /wp:image -->\n\n\t\t<!-- wp:group {\"align\":\"full\",\"layout\":{\"type\":\"default\"}} -->\n\t\t<div class=\"wp-block-group alignfull\">\n\t\t\t<!-- wp:heading {\"align\":\"left\",\"style\":{\"typography\":{\"fontSize\":\"clamp(1rem, 380px, 24vw)\",\"letterSpacing\":\"-0.02em\",\"lineHeight\":\"1\",\"fontWeight\":\"700\",\"fontStyle\":\"normal\"}}} -->\n\t\t\t<h2 class=\"wp-block-heading has-text-align-left\" style=\"font-size:clamp(1rem, 380px, 24vw);font-style:normal;font-weight:700;letter-spacing:-0.02em;line-height:1\">Tracks</h2>\n\t\t\t<!-- /wp:heading -->\n\n\t\t</div>\n\t\t<!-- /wp:group -->\n\t</div>\n\t<!-- /wp:group -->\n</div>\n<!-- /wp:group -->\n\n<!-- wp:group {\"align\":\"full\",\"style\":{\"spacing\":{\"margin\":{\"top\":\"0\",\"bottom\":\"0\"}}},\"layout\":{\"type\":\"constrained\"}} -->\n<div class=\"wp-block-group alignfull\" style=\"margin-top:0;margin-bottom:0\">\n\t<!-- wp:group {\"align\":\"wide\",\"style\":{\"spacing\":{\"padding\":{\"top\":\"var:preset|spacing|50\",\"bottom\":\"var:preset|spacing|50\"},\"blockGap\":\"var:preset|spacing|50\"}},\"layout\":{\"type\":\"default\"}} -->\n\t<div class=\"wp-block-group alignwide\" style=\"padding-top:var(--wp--preset--spacing--50);padding-bottom:var(--wp--preset--spacing--50)\">\n\t\t<!-- wp:heading {\"fontSize\":\"x-large\"} -->\n\t\t<h2 class=\"wp-block-heading has-x-large-font-size\">Frequently Asked Questions</h2>\n\t\t<!-- /wp:heading -->\n\n\t\t<!-- wp:columns {\"style\":{\"spacing\":{\"blockGap\":{\"left\":\"var:preset|spacing|50\"}}}} -->\n\t\t<div class=\"wp-block-columns\">\n\t\t\t<!-- wp:column -->\n\t\t\t<div class=\"wp-block-column\">\n\t\t\t\t<!-- wp:group {\"style\":{\"border\":{\"top\":{\"color\":\"var:preset|color|accent-6\",\"width\":\"1px\"}},\"spacing\":{\"padding\":{\"top\":\"var:preset|spacing|30\",\"bottom\":\"var:preset|spacing|30\"}}},\"layout\":{\"type\":\"default\"}} -->\n\t\t\t\t<div class=\"wp-block-group\" style=\"border-top-color:var(--wp--preset--color--accent-6);border-top-width:1px;padding-top:var(--wp--preset--spacing--30);padding-bottom:var(--wp--preset--spacing--30)\">\n\t\t\t\t\t<!-- wp:heading {\"level\":3} -->\n\t\t\t\t\t<h3 class=\"wp-block-heading\">Who should attend?</h3>\n\t\t\t\t\t<!-- /wp:heading -->\n\n\t\t\t\t\t<!-- wp:paragraph -->\n\t\t\t\t\t<p>The conference is built for events teams managing multi-track conferences—anyone from first-time organizers to seasoned operations leads looking for practical, repeatable frameworks.</p>\n\t\t\t\t\t<!-- /wp:paragraph -->\n\t\t\t\t</div>\n\t\t\t\t<!-- /wp:group -->\n\t\t\t</div>\n\t\t\t<!-- /wp:column -->\n\n\t\t\t<!-- wp:column -->\n\t\t\t<div class=\"wp-block-column\">\n\t\t\t\t<!-- wp:group {\"style\":{\"border\":{\"top\":{\"color\":\"var:preset|color|accent-6\",\"width\":\"1px\"}},\"spacing\":{\"padding\":{\"top\":\"var:preset|spacing|30\",\"bottom\":\"var:preset|spacing|30\"}}},\"layout\":{\"type\":\"default\"}} -->\n\t\t\t\t<div class=\"wp-block-group\" style=\"border-top-color:var(--wp--preset--color--accent-6);border-top-width:1px;padding-top:var(--wp--preset--spacing--30);padding-bottom:var(--wp--preset--spacing--30)\">\n\t\t\t\t\t<!-- wp:heading {\"level\":3} -->\n\t\t\t\t\t<h3 class=\"wp-block-heading\">What does registration include?</h3>\n\t\t\t\t\t<!-- /wp:heading -->\n\n\t\t\t\t\t<!-- wp:paragraph -->\n\t\t\t\t\t<p>Your pass covers all keynotes, breakout sessions, workshops, daily networking lunches, and access to the speaker Q&amp;A portal for 90 days after the event.</p>\n\t\t\t\t\t<!-- /wp:paragraph -->\n\t\t\t\t</div>\n\t\t\t\t<!-- /wp:group -->\n\t\t\t</div>\n\t\t\t<!-- /wp:column -->\n\t\t</div>\n\t\t<!-- /wp:columns -->\n\n\t\t<!-- wp:columns {\"style\":{\"spacing\":{\"blockGap\":{\"left\":\"var:preset|spacing|50\"}}}} -->\n\t\t<div class=\"wp-block-columns\">\n\t\t\t<!-- wp:column -->\n\t\t\t<div class=\"wp-block-column\">\n\t\t\t\t<!-- wp:group {\"style\":{\"border\":{\"top\":{\"color\":\"var:preset|color|accent-6\",\"width\":\"1px\"}},\"spacing\":{\"padding\":{\"top\":\"var:preset|spacing|30\",\"bottom\":\"var:preset|spacing|30\"}}},\"layout\":{\"type\":\"default\"}} -->\n\t\t\t\t<div class=\"wp-block-group\" style=\"border-top-color:var(--wp--preset--color--accent-6);border-top-width:1px;padding-top:var(--wp--preset--spacing--30);padding-bottom:var(--wp--preset--spacing--30)\">\n\t\t\t\t\t<!-- wp:heading {\"level\":3} -->\n\t\t\t\t\t<h3 class=\"wp-block-heading\">Can I switch tracks during the conference?</h3>\n\t\t\t\t\t<!-- /wp:heading -->\n\n\t\t\t\t\t<!-- wp:paragraph -->\n\t\t\t\t\t<p>Absolutely. Your badge gives you open access to every track so you can follow the sessions most relevant to your role in real time.</p>\n\t\t\t\t\t<!-- /wp:paragraph -->\n\t\t\t\t</div>\n\t\t\t\t<!-- /wp:group -->\n\t\t\t</div>\n\t\t\t<!-- /wp:column -->\n\n\t\t\t<!-- wp:column -->\n\t\t\t<div class=\"wp-block-column\">\n\t\t\t\t<!-- wp:group {\"style\":{\"border\":{\"top\":{\"color\":\"var:preset|color|accent-6\",\"width\":\"1px\"}},\"spacing\":{\"padding\":{\"top\":\"var:preset|spacing|30\",\"bottom\":\"var:preset|spacing|30\"}}},\"layout\":{\"type\":\"default\"}} -->\n\t\t\t\t<div class=\"wp-block-group\" style=\"border-top-color:var(--wp--preset--color--accent-6);border-top-width:1px;padding-top:var(--wp--preset--spacing--30);padding-bottom:var(--wp--preset--spacing--30)\">\n\t\t\t\t\t<!-- wp:heading {\"level\":3} -->\n\t\t\t\t\t<h3 class=\"wp-block-heading\">Are group rates available?</h3>\n\t\t\t\t\t<!-- /wp:heading -->\n\n\t\t\t\t\t<!-- wp:paragraph -->\n\t\t\t\t\t<p>Yes. Teams of three or more save 20% per pass. Reach out to our events desk and we’ll set up a single invoice for your whole group.</p>\n\t\t\t\t\t<!-- /wp:paragraph -->\n\t\t\t\t</div>\n\t\t\t\t<!-- /wp:group -->\n\t\t\t</div>\n\t\t\t<!-- /wp:column -->\n\t\t</div>\n\t\t<!-- /wp:columns -->\n\t</div>\n\t<!-- /wp:group -->\n</div>\n<!-- /wp:group 