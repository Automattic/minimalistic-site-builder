  "content": "<!-- wp:cover {\"url\":\"https://live.staticflickr.com/3477/4055876635_9bc3bd70ea_b.jpg\",\"dimRatio\":60,\"customOverlayColor\":\"#0b0f19\",\"isUserOverlayColor\":true,\"minHeight\":560,\"align\":\"full\",\"layout\":{\"type\":\"constrained\"}} -->\n<div class=\"wp-block-cover alignfull\"><img class=\"wp-block-cover__image-background\" alt=\"\" src=\"https://live.staticflickr.com/3477/4055876635_9bc3bd70ea_b.jpg\" data-object-fit=\"cover\"/><span aria-hidden=\"true\" class=\"wp-block-cover__background has-background-dim-60 has-background-dim\" style=\"background-color:#0b0f19\"></span><div class=\"wp-block-cover__inner-container\"><!-- wp:paragraph {\"align\":\"center\",\"fontSize\":\"small\",\"style\":{\"typography\":{\"textTransform\":\"uppercase\",\"letterSpacing\":\"0.08em\"},\"color\":{\"text\":\"#ffffff\"}}} -->\n<p class=\"has-text-align-center has-small-font-size has-text-transform has-text-color\" style=\"text-transform:uppercase;letter-spacing:0.08em;color:#ffffff\"><strong>October 3-5 \u00b7 Berlin</strong></p>\n<!-- /wp:paragraph -->\n\n<!-- wp:heading {\"level\":1,\"textAlign\":\"center\",\"style\":{\"color\":{\"text\":\"#ffffff\"}}} -->\n<h1 class=\"wp-block-heading has-text-align-center has-text-color\" style=\"color:#ffffff\">The Conference</h1>\n<!-- /wp:heading -->\n\n<!-- wp:paragraph {\"align\":\"center\",\"fontSize\":\"large\",\"style\":{\"color\":{\"text\":\"#ffffff\"}}} -->\n<p class=\"has-text-align-center has-large-font-size has-text-color\" style=\"color:#ffffff\">Theme, city, and dates in one line, with the promise just below.</p>\n<!-- /wp:paragraph -->\n\n<!-- wp:buttons {\"layout\":{\"type\":\"flex\",\"justifyContent\":\"center\"}} -->\n<div class=\"wp-block-buttons\"><!-- wp:button -->\n<div class=\"wp-block-button\"><a class=\"wp-block-button__link wp-element-button\">Register</a></div>\n<!-- /wp:button -->\n\n<!-- wp:button {\"className\":\"is-style-outline\"} -->\n<div class=\"wp-block-button is-style-outline\"><a class=\"wp-block-button__link wp-element-button\">See agenda</a></div>\n<!-- /wp:button --></div>\n<!-- /wp:buttons --></div></div>\n<!-- /wp:cover -->\n\n<!-- wp:group {\"align\":\"full\",\"style\":{\"spacing\":{\"padding\":{\"top\":\"clamp(2.25rem, 4vw, 3.25rem)\",\"bottom\":\"clamp(2.25rem, 4vw, 3.25rem)\"},\"blockGap\":\"clamp(1rem, 2vw, 1.5rem)\"}},\"layout\":{\"type\":\"constrained\"},\"backgroundColor\":\"contrast\",\"textColor\":\"base\"} -->\n<div class=\"wp-block-group alignfull has-contrast-background-color has-background has-base-color has-text-color\" style=\"padding-top:clamp(2.25rem, 4vw, 3.25rem);padding-bottom:clamp(2.25rem, 4vw, 3.25rem)\"><!-- wp:columns -->\n<div class=\"wp-block-columns\"><!-- wp:column -->\n<div class=\"wp-block-column\"><!-- wp:heading {\"level\":2,\"textAlign\":\"center\"} -->\n<h2 class=\"wp-block-heading has-text-align-center\">3</h2>\n<!-- /wp:heading -->\n\n<!-- wp:paragraph {\"align\":\"center\"} -->\n<p class=\"has-text-align-center\">Days</p>\n<!-- /wp:paragraph --></div>\n<!-- /wp:column --><!-- wp:column -->\n<div class=\"wp-block-column\"><!-- wp:heading {\"level\":2,\"textAlign\":\"center\"} -->\n<h2 class=\"wp-block-heading has-text-align-center\">5</h2>\n<!-- /wp:heading -->\n\n<!-- wp:paragraph {\"align\":\"center\"} -->\n<p class=\"has-text-align-center\">Tracks</p>\n<!-- /wp:paragraph --></div>\n<!-- /wp:column --><!-- wp:column -->\n<div class=\"wp-block-column\"><!-- wp:heading {\"level\":2,\"textAlign\":\"center\"} -->\n<h2 class=\"wp-block-heading has-text-align-center\">60</h2>\n<!-- /wp:heading -->\n\n<!-- wp:paragraph {\"align\":\"center\"} -->\n<p class=\"has-text-align-center\">Talks</p>\n<!-- /wp:paragraph --></div>\n<!-- /wp:column --><!-- wp:column -->\n<div class=\"wp-block-column\"><!-- wp:heading {\"level\":2,\"textAlign\":\"center\"} -->\n<h2 class=\"wp-block-heading has-text-align-center\">2,000</h2>\n<!-- /wp:heading -->\n\n<!-- wp:paragraph {\"align\":\"center\"} -->\n<p class=\"has-text-align-center\">Attendees</p>\n<!-- /wp:paragraph --></div>\n<!-- /wp:column --></div>\n<!-- /wp:columns --></div>\n<!-- /wp:group -->\n\n<!-- wp:group {\"align\":\"full\",\"style\":{\"spacing\":{\"padding\":{\"top\":\"clamp(3rem, 6vw, 4.5rem)\",\"bottom\":\"clamp(3rem, 6vw, 4.5rem)\"},\"blockGap\":\"clamp(1.5rem, 3vw, 2.25rem)\"}},\"layout\":{\"type\":\"constrained\"}} -->\n<div class=\"wp-block-group alignfull\" style=\"padding-top:clamp(3rem, 6vw, 4.5rem);padding-bottom:clamp(3rem, 6vw, 4.5rem)\"><!-- wp:heading {\"level\":2,\"textAlign\":\"center\"} -->\n<h2 class=\"wp-block-heading has-text-align-center\">Why attend</h2>\n<!-- /wp:heading -->\n\n<!-- wp:columns -->\n<div class=\"wp-block-columns\"><!-- wp:column -->\n<div class=\"wp-block-column\"><!-- wp:heading {\"level\":3} -->\n<h3 class=\"wp-block-heading\">Learn</h3>\n<!-- /wp:heading -->\n\n<!-- wp:paragraph -->\n<p>Sessions across every track.</p>\n<!-- /wp:paragraph --></div>\n<!-- /wp:column --><!-- wp:column -->\n<div class=\"wp-block-column\"><!-- wp:heading {\"level\":3} -->\n<h3 class=\"wp-block-heading\">Connect</h3>\n<!-- /wp:heading -->\n\n<!-- wp:paragraph -->\n<p>Meet peers and partners.</p>\n<!-- /wp:paragraph --></div>\n<!-- /wp:column --><!-- wp:column -->\n<div class=\"wp-block-column\"><!-- wp:heading {\"level\":3} -->\n<h3 class=\"wp-block-heading\">Apply</h3>\n<!-- /wp:heading -->\n\n<!-- wp:paragraph -->\n<p>Leave with a plan you can use.</p>\n<!-- /wp:paragraph --></div>\n<!-- /wp:column --></div>\n<!-- /wp:columns --></div>\n<!-- /wp:group -->\n\n<!-- wp:group {\"align\":\"full\",\"style\":{\"spacing\":{\"padding\":{\"top\":\"clamp(1.5rem, 3vw, 2.25rem)\",\"bottom\":\"clamp(1.5rem, 3vw, 2.25rem)\"},\"blockGap\":\"clamp(0.75rem, 1.5vw, 1rem)\"}},\"layout\":{\"type\":\"constrained\"},\"backgroundColor\":\"accent-6\"} -->\n<div class=\"wp-block-group alignfull has-accent-6-background-color has-background\" style=\"padding-top:clamp(1.5rem, 3vw, 2.25rem);padding-bottom:clamp(1.5rem, 3vw, 2.25rem)\"><!-- wp:paragraph {\"align\":\"center\",\"fontSize\":\"small\"} -->\n<p class=\"has-text-align-center has-small-font-size\">Sponsored by</p>\n<!-- /wp:paragraph -->\n\n<!-- wp:group {\"layout\":{\"type\":\"flex\",\"justifyContent\":\"space-between\",\"flexWrap\":\"wrap\"}} -->\n<div class=\"wp-block-group\"><!-- wp:paragraph {\"fontSize\":\"medium\"} -->\n<p class=\"has-medium-font-size\"><strong>Acme</strong></p>\n<!-- /wp:paragraph --><!-- wp:paragraph {\"fontSize\":\"medium\"} -->\n<p class=\"has-medium-font-size\"><strong>Globex</strong></p>\n<!-- /wp:paragraph --><!-- wp:paragraph {\"fontSize\":\"medium\"} -->\n<p class=\"has-medium-font-size\"><strong>Initech</strong></p>\n<!-- /wp:paragraph --><!-- wp:paragraph {\"fontSize\":\"medium\"} -->\n<p class=\"has-medium-font-size\"><strong>Hooli</strong></p>\n<!-- /wp:paragraph --></div>\n<!-- /wp:group --></div>\n<!-- /wp:group -->\n\n<!-- wp:group {\"align\":\"full\",\"style\":{\"spacing\":{\"padding\":{\"top\":\"clamp(5rem, 11vw, 8rem)\",\"bottom\":\"clamp(5rem, 11vw, 8rem)\"},\"blockGap\":\"clamp(2.5rem, 4vw, 3.5rem)\"}},\"layout\":{\"type\":\"constrained\"},\"backgroundColor\":\"accent-1\",\"textColor\":\"contrast\"} -->\n<div class=\"wp-block-group alignfull has-accent-1-background-color has-background has-contrast-color has-text-color\" style=\"padding-top:clamp(5rem, 11vw, 8rem);padding-bottom:clamp(5rem, 11vw, 8rem)\"><!-- wp:heading {\"level\":2,\"textAlign\":\"center\"} -->\n<h2 class=\"wp-block-heading has-text-align-center\">Join us</h2>\n<!-- /wp:heading -->\n\n<!-- wp:paragraph {\"align\":\"center\"} -->\n<p class=\"has-text-align-center\">Register today and bring your team.</p>\n<!-- /wp:paragraph -->\n\n<!-- wp:buttons {\"layout\":{\"type\":\"flex\",\"justifyContent\":\"center\"}} -->\n<div class=\"wp-block-buttons\"><!-- wp:button -->\n<div class=\"wp-block-button\"><a class=\"wp-block-button__link wp-element-button\">Register</a></div>\n<!-- /wp:button --></div>\n<!-- /wp:buttons --></div>\n<!-- /wp:group -->"
