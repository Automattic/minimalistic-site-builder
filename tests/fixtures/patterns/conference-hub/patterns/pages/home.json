    "content": "<!-- wp:group {\"align\":\"full\",\"className\":\"is-style-section-3\",\"style\":{\"spacing\":{\"padding\":{\"top\":\"var:preset|spacing|50\",\"bottom\":\"var:preset|spacing|50\"},\"margin\":{\"top\":\"0\",\"bottom\":\"0\"}}},\"layout\":{\"type\":\"constrained\"}} -->\n<div class=\"wp-block-group alignfull is-style-section-3\" style=\"margin-top:0;margin-bottom:0;padding-top:var(--wp--preset--spacing--50);padding-bottom:var(--wp--preset--spacing--50)\">\n\t<!-- wp:group {\"align\":\"wide\",\"style\":{\"spacing\":{}},\"layout\":{\"type\":\"constrained\"}} -->\n\t<div class=\"wp-block-group alignwide\">\n\t\t<!-- wp:image {\"sizeSlug\":\"full\",\"linkDestination\":\"none\",\"align\":\"wide\"} -->\n\t\t<figure class=\"wp-block-image alignwide size-full\">\n\t\t\t<img src=\"/wp-content/themes/twentytwentyfive/assets/images/coming-soon-bg-image.webp\" alt=\"Photo of a field full of flowers, a blue sky and a tree.\"/>\n\t\t</figure>\n\t\t<!-- /wp:image -->\n\n\t\t<!-- wp:group {\"align\":\"full\",\"layout\":{\"type\":\"default\"}} -->\n\t\t<div class=\"wp-block-group alignfull\">\n\t\t\t<!-- wp:heading {\"align\":\"left\",\"style\":{\"typography\":{\"fontSize\":\"clamp(1rem, 380px, 24vw)\",\"letterSpacing\":\"-0.02em\",\"lineHeight\":\"1\",\"fontWeight\":\"700\",\"fontStyle\":\"normal\"}}} -->\n\t\t\t<h2 class=\"wp-block-heading has-text-align-left\" style=\"font-size:clamp(1rem, 380px, 24vw);font-style:normal;font-weight:700;letter-spacing:-0.02em;line-height:1\">Conference</h2>\n\t\t\t<!-- /wp:heading -->\n\n\t\t</div>\n\t\t<!-- /wp:group -->\n\t</div>\n\t<!-- /wp:group -->\n</div>\n<!-- /wp:group -->\n\n<!-- wp:group {\"align\":\"full\",\"style\":{\"spacing\":{\"blockGap\":\"0\",\"margin\":{\"top\":\"0\",\"bottom\":\"0\"}}},\"layout\":{\"type\":\"default\"}} -->\n<div class=\"wp-block-group alignfull\" style=\"margin-top:0;margin-bottom:0\">\n\t<!-- wp:columns {\"isStackedOnMobile\":false,\"align\":\"full\",\"style\":{\"spacing\":{\"padding\":{\"top\":\"var:preset|spacing|40\",\"bottom\":\"var:preset|spacing|80\",\"left\":\"var:preset|spacing|40\",\"right\":\"var:preset|spacing|40\"},\"margin\":{\"top\":\"0\",\"bottom\":\"0\"}}}} -->\n\t<div class=\"wp-block-columns alignfull is-not-stacked-on-mobile\" style=\"margin-top:0;margin-bottom:0;padding-top:var(--wp--preset--spacing--40);padding-right:var(--wp--preset--spacing--40);padding-bottom:var(--wp--preset--spacing--80);padding-left:var(--wp--preset--spacing--40)\">\n\t\t<!-- wp:column {\"width\":\"66.66%\"} -->\n\t\t<div class=\"wp-block-column\" style=\"flex-basis:66.66%\">\n\t\t\t<!-- wp:group {\"style\":{\"spacing\":{\"blockGap\":\"var:preset|spacing|20\"}},\"layout\":{\"type\":\"flex\",\"orientation\":\"vertical\",\"justifyContent\":\"stretch\"}} -->\n\t\t\t<div class=\"wp-block-group\">\n\t\t\t\t<!-- wp:heading {\"fontSize\":\"xx-large\"} -->\n\t\t\t\t<h2 class=\"wp-block-heading has-xx-large-font-size\">Unleash Ideas Across Tracks</h2>\n\t\t\t\t<!-- /wp:heading -->\n\n\t\t\t\t<!-- wp:paragraph {\"fontSize\":\"x-large\"} -->\n\t\t\t\t<p class=\"has-x-large-font-size\">Sep 14–16, 2026</p>\n\t\t\t\t<!-- /wp:paragraph -->\n\n\t\t\t\t<!-- wp:spacer {\"height\":\"0px\",\"style\":{\"layout\":{\"selfStretch\":\"fixed\",\"flexSize\":\"140px\"}}} -->\n\t\t\t\t<div style=\"height:0px\" aria-hidden=\"true\" class=\"wp-block-spacer\"></div>\n\t\t\t\t<!-- /wp:spacer -->\n\t\t\t</div>\n\t\t\t<!-- /wp:group -->\n\t\t</div>\n\t\t<!-- /wp:column -->\n\n\t\t<!-- wp:column {\"width\":\"12vw\"} -->\n\t\t<div class=\"wp-block-column\" style=\"flex-basis:12vw\"></div>\n\t\t<!-- /wp:column -->\n\n\t\t<!-- wp:column -->\n\t\t<div class=\"wp-block-column\">\n\t\t\t<!-- wp:group {\"layout\":{\"type\":\"flex\",\"flexWrap\":\"nowrap\",\"justifyContent\":\"right\"}} -->\n\t\t\t<div class=\"wp-block-group\">\n\t\t\t\t<!-- wp:paragraph {\"align\":\"left\",\"style\":{\"typography\":{\"writingMode\":\"vertical-rl\",\"textTransform\":\"uppercase\",\"lineHeight\":\"0.6\"}}} -->\n\t\t\t\t<p class=\"has-text-align-left\" style=\"line-height:0.6;text-transform:uppercase;writing-mode:vertical-rl\">Early Bird</p>\n\t\t\t\t<!-- /wp:paragraph -->\n\t\t\t</div>\n\t\t\t<!-- /wp:group -->\n\t\t</div>\n\t\t<!-- /wp:column -->\n\t</div>\n\t<!-- /wp:columns -->\n\n\t<!-- wp:columns {\"align\":\"full\",\"className\":\"is-style-section-2\",\"style\":{\"spacing\":{\"blockGap\":{\"top\":\"0\",\"left\":\"0\"},\"padding\":{\"top\":\"0\",\"bottom\":\"0\"}}}} -->\n\t<div class=\"wp-block-columns alignfull is-style-section-2\" style=\"padding-top:0;padding-bottom:0\">\n\t\t<!-- wp:column {\"width\":\"50%\"} -->\n\t\t<div class=\"wp-block-column\" style=\"flex-basis:50%\">\n\t\t\t<!-- wp:group {\"style\":{\"spacing\":{\"blockGap\":\"var:preset|spacing|20\",\"padding\":{\"top\":\"var:preset|spacing|50\",\"bottom\":\"var:preset|spacing|50\",\"left\":\"var:preset|spacing|50\",\"right\":\"var:preset|spacing|50\"}},\"dimensions\":{\"minHeight\":\"33vh\"}},\"layout\":{\"type\":\"flex\",\"orientation\":\"vertical\",\"justifyContent\":\"stretch\",\"verticalAlignment\":\"space-between\"}} -->\n\t\t\t<div class=\"wp-block-group\" style=\"min-height:33vh;padding-top:var(--wp--preset--spacing--50);padding-right:var(--wp--preset--spacing--50);padding-bottom:var(--wp--preset--spacing--50);padding-left:var(--wp--preset--spacing--50)\">\n\t\t\t\t<!-- wp:paragraph -->\n\t\t\t\t<p>Join three days packed with keynotes, panels, and hands-on sessions. Explore concurrent tracks, network with peers, and walk away with actionable insights for your next event.</p>\n\t\t\t\t<!-- /wp:paragraph -->\n\n\t\t\t\t<!-- wp:spacer {\"height\":\"0px\",\"style\":{\"layout\":{\"flexSize\":\"100px\",\"selfStretch\":\"fixed\"}}} -->\n\t\t\t\t<div style=\"height:0px\" aria-hidden=\"true\" class=\"wp-block-spacer\"></div>\n\t\t\t\t<!-- /wp:spacer -->\n\n\t\t\t\t<!-- wp:heading {\"fontSize\":\"xx-large\"} -->\n\t\t\t\t<h2 class=\"wp-block-heading has-xx-large-font-size\">Register</h2>\n\t\t\t\t<!-- /wp:heading -->\n\t\t\t</div>\n\t\t\t<!-- /wp:group -->\n\t\t</div>\n\t\t<!-- /wp:column -->\n\n\t\t<!-- wp:column {\"width\":\"50%\"} -->\n\t\t<div class=\"wp-block-column\" style=\"flex-basis:50%\">\n\t\t\t<!-- wp:cover {\"url\":\"/wp-content/themes/twentytwentyfive/assets/images/botany-flowers-closeup.webp\",\"dimRatio\":0,\"isDark\":false} -->\n\t\t\t<div class=\"wp-block-cover is-light\"><span aria-hidden=\"true\" class=\"wp-block-cover__background has-background-dim-0 has-background-dim\"></span><img class=\"wp-block-cover__image-background\" alt=\"Close up photo of white flowers on a grey background\" src=\"/wp-content/themes/twentytwentyfive/assets/images/botany-flowers-closeup.webp\" data-object-fit=\"cover\"/>\n\t\t\t<div class=\"wp-block-cover__inner-container\">\n\t\t\t\t<!-- wp:spacer {\"height\":\"var:preset|spacing|20\"} -->\n\t\t\t\t<div style=\"height:var(--wp--preset--spacing--20)\" aria-hidden=\"true\" class=\"wp-block-spacer\"></div>\n\t\t\t\t<!-- /wp:spacer -->\n\t\t\t</div></div>\n\t\t\t<!-- /wp:cover -->\n\t\t</div>\n\t\t<!-- /wp:column -->\n\t</div>\n\t<!-- /wp:columns -->\n</div>\n<!-- /wp:group -->\n\n<!-- wp:group {\"align\":\"full\",\"className\":\"is-style-section-3\",\"style\":{\"spacing\":{\"padding\":{\"top\":\"var:preset|spacing|50\",\"bottom\":\"var:preset|spacing|50\"},\"margin\":{\"top\":\"0\",\"bottom\":\"0\"}}},\"layout\":{\"type\":\"constrained\"}} -->\n<div class=\"wp-block-group alignfull is-style-section-3\" style=\"margin-top:0;margin-bottom:0;padding-top:var(--wp--preset--spacing--50);padding-bottom:var(--wp--preset--spacing--50)\">\n\t<!-- wp:group {\"align\":\"wide\",\"style\":{\"spacing\":{}},\"layout\":{\"type\":\"constrained\"}} -->\n\t<div class=\"wp-block-group alignwide\">\n\t\t<!-- wp:image {\"sizeSlug\":\"full\",\"linkDestination\":\"none\",\"align\":\"wide\"} -->\n\t\t<figure class=\"wp-block-image alignwide size-full\">\n\t\t\t<img src=\"/wp-content/themes/twentytwentyfive/assets/images/coming-soon-bg-image.webp\" alt=\"Photo of a field full of flowers, a blue sky and a tree.\"/>\n\t\t</figure>\n\t\t<!-- /wp:image -->\n\n\t\t<!-- wp:group {\"align\":\"full\",\"layout\":{\"type\":\"default\"}} -->\n\t\t<div class=\"wp-block-group alignfull\">\n\t\t\t<!-- wp:heading {\"align\":\"left\",\"style\":{\"typography\":{\"fontSize\":\"clamp(1rem, 380px, 24vw)\",\"letterSpacing\":\"-0.02em\",\"lineHeight\":\"1\",\"fontWeight\":\"700\",\"fontStyle\":\"normal\"}}} -->\n\t\t\t<h2 class=\"wp-block-heading has-text-align-left\" style=\"font-size:clamp(1rem, 380px, 24vw);font-style:normal;font-weight:700;letter-spacing:-0.02em;line-height:1\">Tracks</h2>\n\t\t\t<!-- /wp:heading -->\n\n\t\t</div>\n\t\t<!-- /wp:group -->\n\t</div>\n\t<!-- /wp:group -->\n</div>\n<!-- /wp:group -->\n\n<!-- wp:group {\"align\":\"full\",\"className\":\"is-style-section-3\",\"style\":{\"spacing\":{\"padding\":{\"top\":\"var:preset|spacing|50\",\"bottom\":\"var:preset|spacing|50\"},\"margin\":{\"top\":\"0\",\"bottom\":\"0\"}}},\"layout\":{\"type\":\"constrained\"}} -->\n<div class=\"wp-block-group alignfull is-style-section-3\" style=\"margin-top:0;margin-bottom:0;padding-top:var(--wp--preset--spacing--50);padding-bottom:var(--wp--preset--spacing--50)\">\n\t<!-- wp:group {\"align\":\"wide\",\"style\":{\"spacing\":{}},\"layout\":{\"type\":\"constrained\"}} -->\n\t<div class=\"wp-block-group alignwide\">\n\t\t<!-- wp:image {\"sizeSlug\":\"full\",\"linkDestination\":\"none\",\"align\":\"wide\"} -->\n\t\t<figure class=\"wp-block-image alignwide size-full\">\n\t\t\t<img src=\"/wp-content/themes/twentytwentyfive/assets/images/coming-soon-bg-image.webp\" alt=\"Photo of a field full of flowers, a blue sky and a tree.\"/>\n\t\t</figure>\n\t\t<!-- /wp:image -->\n\n\t\t<!-- wp:group {\"align\":\"full\",\"layout\":{\"type\":\"default\"}} -->\n\t\t<div class=\"wp-block-group alignfull\">\n\t\t\t<!-- wp:heading {\"align\":\"left\",\"style\":{\"typography\":{\"fontSize\":\"clamp(1rem, 380px, 24vw)\",\"letterSpacing\":\"-0.02em\",\"lineHeight\":\"1\",\"fontWeight\":\"700\",\"fontStyle\":\"normal\"}}} -->\n\t\t\t<h2 class=\"wp-block-heading has-text-align-left\" style=\"font-size:clamp(1rem, 380px, 24vw);font-style:normal;font-weight:700;letter-spacing:-0.02em;line-height:1\">Speakers</h2>\n\t\t\t<!-- /wp:heading -->\n\n\t\t</div>\n\t\t<!-- /wp:group -->\n\t</div>\n\t<!-- /wp:group -->\n</div>\n<!-- /wp:group -->\n\n<!-- wp:group {\"align\":\"full\",\"style\":{\"spacing\":{\"padding\":{\"top\":\"var:preset|spacing|60\",\"bottom\":\"var:preset|spacing|60\"},\"margin\":{\"top\":\"0\",\"bottom\":\"0\"}}},\"layout\":{\"type\":\"constrained\"}} -->\n<div class=\"wp-block-group alignfull\" style=\"margin-top:0;margin-bottom:0;padding-top:var(--wp--preset--spacing--60);padding-bottom:var(--wp--preset--spacing--60)\">\n\t<!-- wp:columns {\"align\":\"wide\",\"style\":{\"spacing\":{\"blockGap\":{\"top\":\"var:preset|spacing|60\",\"left\":\"var:preset|spacing|50\"}}}} -->\n\t<div class=\"wp-block-columns alignwide\">\n\t\t<!-- wp:column -->\n\t\t<div class=\"wp-block-column\">\n\t\t\t<!-- wp:columns {\"style\":{\"spacing\":{\"blockGap\":{\"top\":\"var:preset|spacing|40\",\"left\":\"var:preset|spacing|40\"}}}} -->\n\t\t\t<div class=\"wp-block-columns\">\n\t\t\t\t<!-- wp:column {\"width\":\"64px\"} -->\n\t\t\t\t<div class=\"wp-block-column\" style=\"flex-basis:64px\">\n\t\t\t\t\t<!-- wp:image {\"width\":\"64px\",\"aspectRatio\":\"1\",\"scale\":\"cover\",\"sizeSlug\":\"large\",\"linkDestination\":\"none\",\"className\":\"is-style-rounded\"} -->\n\t\t\t\t\t<figure class=\"wp-block-image size-large is-resized is-style-rounded\"><img src=\"/wp-content/themes/twentytwentyfive/assets/images/nurse.webp\" alt=\"Picture of a person\" style=\"aspect-ratio:1;object-fit:cover;width:64px\"/></figure>\n\t\t\t\t\t<!-- /wp:image -->\n\t\t\t\t</div>\n\t\t\t\t<!-- /wp:column -->\n\n\t\t\t\t<!-- wp:column -->\n\t\t\t\t<div class=\"wp-block-column\">\n\t\t\t\t\t<!-- wp:quote {\"className\":\"is-style-plain\",\"style\":{\"typography\":{\"fontStyle\":\"normal\",\"fontWeight\":\"400\"},\"spacing\":{\"blockGap\":\"var:preset|spacing|40\"}},\"fontSize\":\"x-large\"} -->\n\t\t\t\t\t<blockquote class=\"wp-block-quote is-style-plain has-x-large-font-size\" style=\"font-style:normal;font-weight:400\">\n\t\t\t\t\t\t<!-- wp:paragraph {\"style\":{\"typography\":{\"lineHeight\":\"1.1\"}}} -->\n\t\t\t\t\t\t<p style=\"line-height:1.1\">Everything a conference hub should be.</p>\n\t\t\t\t\t\t<!-- /wp:paragraph -->\n\t\t\t\t\t\t<cite>Jo Mulligan <br /><sub>Atlanta, GA</sub></cite>\n\t\t\t\t\t</blockquote>\n\t\t\t\t\t<!-- /wp:quote -->\n\t\t\t\t</div>\n\t\t\t\t<!-- /wp:column -->\n\t\t\t</div>\n\t\t\t<!-- /wp:columns -->\n\t\t</div>\n\t\t<!-- /wp:column -->\n\n\t\t<!-- wp:column {\"width\":\"\"} -->\n\t\t<div class=\"wp-block-column\">\n\t\t\t<!-- wp:columns {\"style\":{\"spacing\":{\"blockGap\":{\"top\":\"var:preset|spacing|40\",\"left\":\"var:preset|spacing|40\"}}}} -->\n\t\t\t<div class=\"wp-block-columns\">\n\t\t\t\t<!-- wp:column {\"width\":\"64px\"} -->\n\t\t\t\t<div class=\"wp-block-column\" style=\"flex-basis:64px\">\n\t\t\t\t\t<!-- wp:image {\"width\":\"64px\",\"aspectRatio\":\"1\",\"scale\":\"cover\",\"sizeSlug\":\"large\",\"linkDestination\":\"none\",\"className\":\"is-style-rounded\"} -->\n\t\t\t\t\t<figure class=\"wp-block-image size-large is-resized is-style-rounded\"><img src=\"/wp-content/themes/twentytwentyfive/assets/images/nurse.webp\" alt=\"Picture of a person\" style=\"aspect-ratio:1;object-fit:cover;width:64px\"/></figure>\n\t\t\t\t\t<!-- /wp:image -->\n\t\t\t\t</div>\n\t\t\t\t<!-- /wp:column -->\n\n\t\t\t\t<!-- wp:column -->\n\t\t\t\t<div class=\"wp-block-column\">\n\t\t\t\t\t<!-- wp:quote {\"className\":\"is-style-plain\",\"style\":{\"typography\":{\"fontStyle\":\"normal\",\"fontWeight\":\"400\"},\"spacing\":{\"blockGap\":\"var:preset|spacing|40\"}},\"fontSize\":\"x-large\"} -->\n\t\t\t\t\t<blockquote class=\"wp-block-quote is-style-plain has-x-large-font-size\" style=\"font-style:normal;font-weight:400\">\n\t\t\t\t\t\t<!-- wp:paragraph {\"style\":{\"typography\":{\"lineHeight\":\"1.1\"}}} -->\n\t\t\t\t\t\t<p style=\"line-height:1.1\">The central hub brought clarity to our three-day summit.</p>\n\t\t\t\t\t\t<!-- /wp:paragraph -->\n\t\t\t\t\t\t<cite>Otto Reid <br><sub>Springfield, IL</sub></cite>\n\t\t\t\t\t</blockquote>\n\t\t\t\t\t<!-- /wp:quote -->\n\t\t\t\t</div>\n\t\t\t\t<!-- /wp:column -->\n\t\t\t</div>\n\t\t\t<!-- /wp:columns -->\n\t\t</div>\n\t\t<!-- /wp:column -->\n\t</div>\n\t<!-- /wp:columns -->\n</div>\n<!-- /wp:group -->\n\n<!-- wp:group {\"align\":\"full\",\"style\":{\"spacing\":{\"margin\":{\"top\":\"0\",\"bottom\":\"0\"}}},\"layout\":{\"type\":\"constrained\"}} -->\n<div class=\"wp-block-group alignfull\" style=\"margin-top:0;margin-bottom:0\">\n\t<!-- wp:group {\"align\":\"wide\",\"style\":{\"spacing\":{\"padding\":{\"top\":\"var:preset|spacing|50\",\"bottom\":\"var:preset|spacing|50\"},\"blockGap\":\"var:preset|spacing|50\"}},\"layout\":{\"type\":\"default\"}} -->\n\t<div class=\"wp-block-group alignwide\" style=\"padding-top:var(--wp--preset--spacing--50);padding-bottom:var(--wp--preset--spacing--50)\">\n\t\t<!-- wp:heading {\"fontSize\":\"x-large\"} -->\n\t\t<h2 class=\"wp-block-heading has-x-large-font-size\">Common Questions</h2>\n\t\t<!-- /wp:heading -->\n\n\t\t<!-- wp:columns {\"style\":{\"spacing\":{\"blockGap\":{\"left\":\"var:preset|spacing|50\"}}}} -->\n\t\t<div class=\"wp-block-columns\">\n\t\t\t<!-- wp:column -->\n\t\t\t<div class=\"wp-block-column\">\n\t\t\t\t<!-- wp:group {\"style\":{\"border\":{\"top\":{\"color\":\"var:preset|color|accent-6\",\"width\":\"1px\"}},\"spacing\":{\"padding\":{\"top\":\"var:preset|spacing|30\",\"bottom\":\"var:preset|spacing|30\"}}},\"layout\":{\"type\":\"default\"}} -->\n\t\t\t\t<div class=\"wp-block-group\" style=\"border-top-color:var(--wp--preset--color--accent-6);border-top-width:1px;padding-top:var(--wp--preset--spacing--30);padding-bottom:var(--wp--preset--spacing--30)\">\n\t\t\t\t\t<!-- wp:heading {\"level\":3} -->\n\t\t\t\t\t<h3 class=\"wp-block-heading\">How many tracks can I run?</h3>\n\t\t\t\t\t<!-- /wp:heading -->\n\n\t\t\t\t\t<!-- wp:paragraph -->\n\t\t\t\t\t<p>You can set up as many concurrent tracks as your schedule demands. The hub scales to handle keynotes, breakout rooms, and workshops in one unified view.</p>\n\t\t\t\t\t<!-- /wp:paragraph -->\n\t\t\t\t</div>\n\t\t\t\t<!-- /wp:group -->\n\t\t\t</div>\n\t\t\t<!-- /wp:column -->\n\n\t\t\t<!-- wp:column -->\n\t\t\t<div class=\"wp-block-column\">\n\t\t\t\t<!-- wp:group {\"style\":{\"border\":{\"top\":{\"color\":\"var:preset|color|accent-6\",\"width\":\"1px\"}},\"spacing\":{\"padding\":{\"top\":\"var:preset|spacing|30\",\"bottom\":\"var:preset|spacing|30\"}}},\"layout\":{\"type\":\"default\"}} -->\n\t\t\t\t<div class=\"wp-block-group\" style=\"border-top-color:var(--wp--preset--color--accent-6);border-top-width:1px;padding-top:var(--wp--preset--spacing--30);padding-bottom:var(--wp--preset--spacing--30)\">\n\t\t\t\t\t<!-- wp:heading {\"level\":3} -->\n\t\t\t\t\t<h3 class=\"wp-block-heading\">Is there a per-attendee cost?</h3>\n\t\t\t\t\t<!-- /wp:heading -->\n\n\t\t\t\t\t<!-- wp:paragraph -->\n\t\t\t\t\t<p>Pricing is based on the event, not per head. A single flat rate covers every attendee, every session, and all speaker tools across your conference days.</p>\n\t\t\t\t\t<!-- /wp:paragraph -->\n\t\t\t\t</div>\n\t\t\t\t<!-- /wp:group -->\n\t\t\t</div>\n\t\t\t<!-- /wp:column -->\n\t\t</div>\n\t\t<!-- /wp:columns -->\n\n\t\t<!-- wp:columns {\"style\":{\"spacing\":{\"blockGap\":{\"left\":\"var:preset|spacing|50\"}}}} -->\n\t\t<div class=\"wp-block-columns\">\n\t\t\t<!-- wp:column -->\n\t\t\t<div class=\"wp-block-column\">\n\t\t\t\t<!-- wp:group {\"style\":{\"border\":{\"top\":{\"color\":\"var:preset|color|accent-6\",\"width\":\"1px\"}},\"spacing\":{\"padding\":{\"top\":\"var:preset|spacing|30\",\"bottom\":\"var:preset|spacing|30\"}}},\"layout\":{\"type\":\"default\"}} -->\n\t\t\t\t<div class=\"wp-block-group\" style=\"border-top-color:var(--wp--preset--color--accent-6);border-top-width:1px;padding-top:var(--wp--preset--spacing--30);padding-bottom:var(--wp--preset--spacing--30)\">\n\t\t\t\t\t<!-- wp:heading {\"level\":3} -->\n\t\t\t\t\t<h3 class=\"wp-block-heading\">Can attendees switch sessions mid-conference?</h3>\n\t\t\t\t\t<!-- /wp:heading -->\n\n\t\t\t\t\t<!-- wp:paragraph -->\n\t\t\t\t\t<p>Absolutely. Attendees move freely between tracks and sessions. Their personal schedule updates in real time, so they never miss a talk they care about.</p>\n\t\t\t\t\t<!-- /wp:paragraph -->\n\t\t\t\t</div>\n\t\t\t\t<!-- /wp:group -->\n\t\t\t</div>\n\t\t\t<!-- /wp:column -->\n\n\t\t\t<!-- wp:column -->\n\t\t\t<div class=\"wp-block-column\">\n\t\t\t\t<!-- wp:group {\"style\":{\"border\":{\"top\":{\"color\":\"var:preset|color|accent-6\",\"width\":\"1px\"}},\"spacing\":{\"padding\":{\"top\":\"var:preset|spacing|30\",\"bottom\":\"var:preset|spacing|30\"}}},\"layout\":{\"type\":\"default\"}} -->\n\t\t\t\t<div class=\"wp-block-group\" style=\"border-top-color:var(--wp--preset--color--accent-6);border-top-width:1px;padding-top:var(--wp--preset--spacing--30);padding-bottom:var(--wp--preset--spacing--30)\">\n\t\t\t\t\t<!-- wp:heading {\"level\":3} -->\n\t\t\t\t\t<h3 class=\"wp-block-heading\">Do you support virtual passes?</h3>\n\t\t\t\t\t<!-- /wp:heading -->\n\n\t\t\t\t\t<!-- wp:paragraph -->\n\t\t\t\t\t<p>Yes, every registration includes live-stream access. Remote attendees can join sessions, ask questions, and browse recorded talks afterward through the same hub.</p>\n\t\t\t\t\t<!-- /wp:paragraph -->\n\t\t\t\t</div>\n\t\t\t\t<!-- /wp:group -->\n\t\t\t</div>\n\t\t\t<!-- /wp:column -->\n\t\t</div>\n\t\t<!-- /wp:columns -->\n\t</div>\n\t<!-- /wp:group -->\n</div>\n<!-- /wp:group -->"
}
