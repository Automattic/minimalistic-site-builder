    "content": "<!-- wp:group {\"align\":\"full\",\"style\":{\"spacing\":{\"padding\":{\"top\":\"var:preset|spacing|50\",\"bottom\":\"var:preset|spacing|50\"},\"margin\":{\"top\":\"0\",\"bottom\":\"0\"}}},\"layout\":{\"type\":\"constrained\"}} -->\n<div class=\"wp-block-group alignfull\" style=\"margin-top:0;margin-bottom:0;padding-top:var(--wp--preset--spacing--50);padding-bottom:var(--wp--preset--spacing--50)\">\n\t<!-- wp:group {\"align\":\"wide\",\"style\":{\"spacing\":{\"blockGap\":\"var:preset|spacing|50\"}},\"layout\":{\"type\":\"grid\",\"minimumColumnWidth\":\"18rem\"}} -->\n\t<div class=\"wp-block-group alignwide\">\n\t\t<!-- wp:group {\"className\":\"is-style-section-3\",\"style\":{\"dimensions\":{\"minHeight\":\"297px\"}},\"layout\":{\"type\":\"constrained\"}} -->\n\t\t<div class=\"wp-block-group is-style-section-3\" style=\"min-height:297px\">\n\t\t\t<!-- wp:group {\"style\":{\"dimensions\":{\"minHeight\":\"100%\"},\"spacing\":{\"blockGap\":\"var:preset|spacing|20\"}},\"layout\":{\"type\":\"flex\",\"orientation\":\"vertical\",\"verticalAlignment\":\"center\",\"justifyContent\":\"center\"}} -->\n\t\t\t<div class=\"wp-block-group\" style=\"min-height:100%\">\n\t\t\t\t<!-- wp:heading {\"fontSize\":\"large\"} -->\n\t\t\t\t<h2 class=\"wp-block-heading has-large-font-size\">@SummitCentral</h2>\n\t\t\t\t<!-- /wp:heading -->\n\n\t\t\t\t<!-- wp:paragraph {\"align\":\"center\",\"fontSize\":\"medium\"} -->\n\t\t\t\t<p class=\"has-text-align-center has-medium-font-size\"><a href=\"#\">#ConfHub2026</a></p>\n\t\t\t\t<!-- /wp:paragraph -->\n\t\t\t\t</div>\n\t\t\t<!-- /wp:group -->\n\t\t</div>\n\t\t<!-- /wp:group -->\n\n\t\t<!-- wp:image {\"aspectRatio\":\"1\",\"scale\":\"cover\",\"sizeSlug\":\"full\",\"linkDestination\":\"none\"} -->\n\t\t<figure class=\"wp-block-image size-full\"><img src=\"/wp-content/themes/twentytwentyfive/assets/images/flower-meadow-square.webp\" alt=\"Photo of a field full of flowers, a blue sky and a tree.\" style=\"aspect-ratio:1;object-fit:cover\"/></figure>\n\t\t<!-- /wp:image -->\n\n\t\t<!-- wp:image {\"aspectRatio\":\"1\",\"scale\":\"cover\",\"sizeSlug\":\"full\",\"linkDestination\":\"none\"} -->\n\t\t<figure class=\"wp-block-image size-full\"><img src=\"/wp-content/themes/twentytwentyfive/assets/images/vash-gon-square.webp\" alt=\"Profile portrait of a native person.\" style=\"aspect-ratio:1;object-fit:cover\"/></figure>\n\t\t<!-- /wp:image -->\n\n\t\t<!-- wp:image {\"aspectRatio\":\"1\",\"scale\":\"cover\",\"sizeSlug\":\"full\",\"linkDestination\":\"none\"} -->\n\t\t<figure class=\"wp-block-image size-full\"><img src=\"/wp-content/themes/twentytwentyfive/assets/images/coral-square.webp\" alt=\"View of the deep ocean.\" style=\"aspect-ratio:1;object-fit:cover\"/></figure>\n\t\t<!-- /wp:image -->\n\n\t\t<!-- wp:image {\"aspectRatio\":\"1\",\"scale\":\"cover\",\"sizeSlug\":\"full\",\"linkDestination\":\"none\"} -->\n\t\t<figure class=\"wp-block-image size-full\"><img src=\"/wp-content/themes/twentytwentyfive/assets/images/agenda-img-4.webp\" alt=\"Portrait of an African Woman dressed in traditional costume, wearing decorative jewelry.\" style=\"aspect-ratio:1;object-fit:cover\"/></figure>\n\t\t<!-- /wp:image -->\n\n\t\t<!-- wp:image {\"aspectRatio\":\"1\",\"scale\":\"cover\",\"sizeSlug\":\"full\",\"linkDestination\":\"none\"} -->\n\t\t<figure class=\"wp-block-image size-full\"><img src=\"/wp-content/themes/twentytwentyfive/assets/images/parthenon-square.webp\" alt=\"The Acropolis of Athens.\" style=\"aspect-ratio:1;object-fit:cover\"/></figure>\n\t\t<!-- /wp:image -->\n\n\t\t<!-- wp:image {\"aspectRatio\":\"1\",\"scale\":\"cover\",\"sizeSlug\":\"full\",\"linkDestination\":\"none\"} -->\n\t\t<figure class=\"wp-block-image size-full\"><img src=\"/wp-content/themes/twentytwentyfive/assets/images/dallas-creek-square.webp\" alt=\"Close up of two flowers on a dark background.\" style=\"aspect-ratio:1;object-fit:cover\"/></figure>\n\t\t<!-- /wp:image -->\n\n\t\t<!-- wp:image {\"aspectRatio\":\"1\",\"scale\":\"cover\",\"sizeSlug\":\"full\",\"linkDestination\":\"none\"} -->\n\t\t<figure class=\"wp-block-image size-full\"><img src=\"/wp-content/themes/twentytwentyfive/assets/images/marshland-birds-square.webp\" alt=\"Birds on a lake.\" style=\"aspect-ratio:1;object-fit:cover\"/></figure>\n\t\t<!-- /wp:image -->\n\t</div>\n\t<!-- /wp:group -->\n</div>\n<!-- /wp:group -->\n\n<!-- wp:group {\"align\":\"full\",\"style\":{\"spacing\":{\"margin\":{\"top\":\"0\",\"bottom\":\"0\"}}},\"layout\":{\"type\":\"constrained\"}} -->\n<div class=\"wp-block-group alignfull\" style=\"margin-top:0;margin-bottom:0\">\n\t<!-- wp:group {\"align\":\"wide\",\"style\":{\"spacing\":{\"padding\":{\"top\":\"var:preset|spacing|50\",\"bottom\":\"var:preset|spacing|50\"},\"blockGap\":\"var:preset|spacing|50\"}},\"layout\":{\"type\":\"default\"}} -->\n\t<div class=\"wp-block-group alignwide\" style=\"padding-top:var(--wp--preset--spacing--50);padding-bottom:var(--wp--preset--spacing--50)\">\n\t\t<!-- wp:heading {\"fontSize\":\"x-large\"} -->\n\t\t<h2 class=\"wp-block-heading has-x-large-font-size\">Venue FAQs</h2>\n\t\t<!-- /wp:heading -->\n\n\t\t<!-- wp:columns {\"style\":{\"spacing\":{\"blockGap\":{\"left\":\"var:preset|spacing|50\"}}}} -->\n\t\t<div class=\"wp-block-columns\">\n\t\t\t<!-- wp:column -->\n\t\t\t<div class=\"wp-block-column\">\n\t\t\t\t<!-- wp:group {\"style\":{\"border\":{\"top\":{\"color\":\"var:preset|color|accent-6\",\"width\":\"1px\"}},\"spacing\":{\"padding\":{\"top\":\"var:preset|spacing|30\",\"bottom\":\"var:preset|spacing|30\"}}},\"layout\":{\"type\":\"default\"}} -->\n\t\t\t\t<div class=\"wp-block-group\" style=\"border-top-color:var(--wp--preset--color--accent-6);border-top-width:1px;padding-top:var(--wp--preset--spacing--30);padding-bottom:var(--wp--preset--spacing--30)\">\n\t\t\t\t\t<!-- wp:heading {\"level\":3} -->\n\t\t\t\t\t<h3 class=\"wp-block-heading\">Where exactly is the venue located?</h3>\n\t\t\t\t\t<!-- /wp:heading -->\n\n\t\t\t\t\t<!-- wp:paragraph -->\n\t\t\t\t\t<p>The main entrance is on Market Street, directly opposite the central tram stop. Look for the blue conference banners once you exit the station.</p>\n\t\t\t\t\t<!-- /wp:paragraph -->\n\t\t\t\t</div>\n\t\t\t\t<!-- /wp:group -->\n\t\t\t</div>\n\t\t\t<!-- /wp:column -->\n\n\t\t\t<!-- wp:column -->\n\t\t\t<div class=\"wp-block-column\">\n\t\t\t\t<!-- wp:group {\"style\":{\"border\":{\"top\":{\"color\":\"var:preset|color|accent-6\",\"width\":\"1px\"}},\"spacing\":{\"padding\":{\"top\":\"var:preset|spacing|30\",\"bottom\":\"var:preset|spacing|30\"}}},\"layout\":{\"type\":\"default\"}} -->\n\t\t\t\t<div class=\"wp-block-group\" style=\"border-top-color:var(--wp--preset--color--accent-6);border-top-width:1px;padding-top:var(--wp--preset--spacing--30);padding-bottom:var(--wp--preset--spacing--30)\">\n\t\t\t\t\t<!-- wp:heading {\"level\":3} -->\n\t\t\t\t\t<h3 class=\"wp-block-heading\">Is there parking available on site?</h3>\n\t\t\t\t\t<!-- /wp:heading -->\n\n\t\t\t\t\t<!-- wp:paragraph -->\n\t\t\t\t\t<p>Underground parking is available with a flat daily rate for attendees. Spaces fill early, so we recommend arriving before the first session.</p>\n\t\t\t\t\t<!-- /wp:paragraph -->\n\t\t\t\t</div>\n\t\t\t\t<!-- /wp:group -->\n\t\t\t</div>\n\t\t\t<!-- /wp:column -->\n\t\t</div>\n\t\t<!-- /wp:columns -->\n\n\t\t<!-- wp:columns {\"style\":{\"spacing\":{\"blockGap\":{\"left\":\"var:preset|spacing|50\"}}}} -->\n\t\t<div class=\"wp-block-columns\">\n\t\t\t<!-- wp:column -->\n\t\t\t<div class=\"wp-block-column\">\n\t\t\t\t<!-- wp:group {\"style\":{\"border\":{\"top\":{\"color\":\"var:preset|color|accent-6\",\"width\":\"1px\"}},\"spacing\":{\"padding\":{\"top\":\"var:preset|spacing|30\",\"bottom\":\"var:preset|spacing|30\"}}},\"layout\":{\"type\":\"default\"}} -->\n\t\t\t\t<div class=\"wp-block-group\" style=\"border-top-color:var(--wp--preset--color--accent-6);border-top-width:1px;padding-top:var(--wp--preset--spacing--30);padding-bottom:var(--wp--preset--spacing--30)\">\n\t\t\t\t\t<!-- wp:heading {\"level\":3} -->\n\t\t\t\t\t<h3 class=\"wp-block-heading\">What accommodation options are nearby?</h3>\n\t\t\t\t\t<!-- /wp:heading -->\n\n\t\t\t\t\t<!-- wp:paragraph -->\n\t\t\t\t\t<p>Three partner hotels sit within a five-minute walk. Discounted rates are available when you mention the conference during booking.</p>\n\t\t\t\t\t<!-- /wp:paragraph -->\n\t\t\t\t</div>\n\t\t\t\t<!-- /wp:group -->\n\t\t\t</div>\n\t\t\t<!-- /wp:column -->\n\n\t\t\t<!-- wp:column -->\n\t\t\t<div class=\"wp-block-column\">\n\t\t\t\t<!-- wp:group {\"style\":{\"border\":{\"top\":{\"color\":\"var:preset|color|accent-6\",\"width\":\"1px\"}},\"spacing\":{\"padding\":{\"top\":\"var:preset|spacing|30\",\"bottom\":\"var:preset|spacing|30\"}}},\"layout\":{\"type\":\"default\"}} -->\n\t\t\t\t<div class=\"wp-block-group\" style=\"border-top-color:var(--wp--preset--color--accent-6);border-top-width:1px;padding-top:var(--wp--preset--spacing--30);padding-bottom:var(--wp--preset--spacing--30)\">\n\t\t\t\t\t<!-- wp:heading {\"level\":3} -->\n\t\t\t\t\t<h3 class=\"wp-block-heading\">What dining is available?</h3>\n\t\t\t\t\t<!-- /wp:heading -->\n\n\t\t\t\t\t<!-- wp:paragraph -->\n\t\t\t\t\t<p>The venue has two cafés and a seated restaurant on the ground floor. Lunch is provided between sessions, with dietary options clearly labeled at each station.</p>\n\t\t\t\t\t<!-- /wp:paragraph -->\n\t\t\t\t</div>\n\t\t\t\t<!-- /wp:group -->\n\t\t\t</div>\n\t\t\t<!-- /wp:column -->\n\t\t</div>\n\t\t<!-- /wp:columns -->\n\t</div>\n\t<!-- /wp:group -->\n</div>\n<!-- /wp:group -->"
}
