ull\" style=\"padding-top:clamp(3rem, 6vw, 4.5rem);padding-bottom:clamp(3rem, 6vw, 4.5rem)\"><!-- wp:heading {\"level\":2,\"textAlign\":\"center\"} -->\n<h2 class=\"wp-block-heading has-text-align-center\">Tracks</h2>\n<!-- /wp:heading -->\n\n<!-- wp:columns -->\n<div class=\"wp-block-columns\"><!-- wp:column -->\n<div class=\"wp-block-column\"><!-- wp:heading {\"level\":3} -->\n<h3 class=\"wp-block-heading\">Engineering</h3>\n<!-- /wp:heading -->\n\n<!-- wp:paragraph -->\n<p>Architecture, scale, and reliability.</p>\n<!-- /wp:paragraph --></div>\n<!-- /wp:column --><!-- wp:column -->\n<div class=\"wp-block-column\"><!-- wp:heading {\"level\":3} -->\n<h3 class=\"wp-block-heading\">Design</h3>\n<!-- /wp:heading -->\n\n<!-- wp:paragraph -->\n<p>Craft, systems, and research.</p>\n<!-- /wp:paragraph --></div>\n<!-- /wp:column --><!-- wp:column -->\n<div class=\"wp-block-column\"><!-- wp:heading {\"level\":3} -->\n<h3 class=\"wp-block-heading\">Product</h3>\n<!-- /wp:heading -->\n\n<!-- wp:paragraph -->\n<p>Strategy, growth, and discovery.</p>\n<!-- /wp:paragraph --></div>\n<!-- /wp:column --></div>\n<!-- /wp:columns --></div>\n<!-- /wp:group -->"
