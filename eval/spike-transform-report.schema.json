{
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "$id": "https://github.com/Automattic/minimalistic-site-builder/blob/trunk/eval/spike-transform-report.schema.json",
    "title": "Transformer spike report",
    "type": "object",
    "required": [
        "fallback_count",
        "fallback_codes",
        "block_histogram",
        "carried_css_bytes",
        "fixup_outcomes",
        "header_detected",
        "footer_detected"
    ],
    "additionalProperties": false,
    "properties": {
        "fallback_count": {
            "type": "integer",
            "minimum": 0
        },
        "fallback_codes": {
            "type": "array",
            "items": {
                "type": "string"
            }
        },
        "block_histogram": {
            "type": "object",
            "additionalProperties": {
                "type": "integer",
                "minimum": 0
            }
        },
        "carried_css_bytes": {
            "type": "integer",
            "minimum": 0
        },
        "fixup_outcomes": {
            "type": "object",
            "required": [
                "normalize-layout",
                "contrast-fix",
                "motion-sanity",
                "fix-blocks"
            ],
            "additionalProperties": false,
            "properties": {
                "normalize-layout": {
                    "enum": [
                        "noop",
                        "mutated",
                        "destroyed"
                    ]
                },
                "contrast-fix": {
                    "enum": [
                        "noop",
                        "mutated",
                        "destroyed"
                    ]
                },
                "motion-sanity": {
                    "enum": [
                        "noop",
                        "mutated",
                        "destroyed"
                    ]
                },
                "fix-blocks": {
                    "enum": [
                        "noop",
                        "mutated",
                        "destroyed"
                    ]
                }
            }
        },
        "header_detected": {
            "type": "boolean"
        },
        "footer_detected": {
            "type": "boolean"
        }
    }
}
