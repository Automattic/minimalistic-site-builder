{
  "name": "automattic/site-build",
  "description": "Generate a WordPress block theme from a one-line prompt.",
  "type": "library",
  "license": "GPL-2.0-or-later",
  "require": {
    "php": ">=8.1"
  },
  "autoload": {
    "psr-4": {
      "Automattic\\SiteBuild\\": "src/"
    }
  },
  "config": {
    "sort-packages": true,
    "optimize-autoloader": true
  }
}
