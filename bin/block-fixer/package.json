{
  "name": "block-fixer",
  "private": true,
  "description": "WordPress block markup fixer script",
  "scripts": {
    "test": "node --test --test-concurrency=1 test/*.test.js",
    "oracle:verify": "node ../../bin/generate-block-fixer-fixtures.js && node ../../bin/generate-block-registry.js",
    "oracle:update": "node ../../bin/generate-block-fixer-fixtures.js --update && node ../../bin/generate-block-registry.js --update && node ../../bin/generate-block-fixer-fixtures.js --update",
    "probe-save": "node probe-save.js"
  },
  "dependencies": {
    "@wordpress/block-editor": "15.15.0",
    "@wordpress/block-library": "9.42.0",
    "@wordpress/block-serialization-default-parser": "5.49.0",
    "@wordpress/blocks": "15.15.0",
    "@wordpress/data": "10.42.0",
    "@wordpress/hooks": "4.42.0",
    "jsdom": "29.0.1"
  }
}
