            "markup": "<!-- wp:group {\"className\":\"approved-hero\",\"style\":{\"spacing\":{\"padding\":{\"top\":\"48px\"}}}} -->\n<div class=\"wp-block-group approved-hero\" style=\"padding-top:48px\"><!-- wp:heading {\"level\":1} -->\n<h1 class=\"wp-block-heading\">Example heading</h1>\n<!-- /wp:heading -->\n\n<!-- wp:paragraph -->\n<p>Example address</p>\n<!-- /wp:paragraph -->\n\n<!-- wp:image {\"sizeSlug\":\"large\",\"linkDestination\":\"none\"} -->\n<figure class=\"wp-block-image size-large\"><img src=\"https://example.test/placeholder.jpg\" alt=\"Example image\"/></figure>\n<!-- /wp:image --></div>\n<!-- /wp:group -->",
            "slots": [
                {
                    "id": "headline",
                    "block_path": [0, 0],
                    "field": "text",
                    "max_words": 8,
                    "fallback": "Welcome to our studio",
                    "instruction": "A welcoming heading for the studio."
                },
                {
                    "id": "address",
                    "block_path": [0, 1],
                    "field": "text",
