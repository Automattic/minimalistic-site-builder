                },
                {
                    "id": "hero-image",
                    "block_path": [0, 2],
                    "field": "url",
                    "binding": "hero_image",
                    "fallback": "https://example.test/placeholder.jpg"
                },
                {
                    "id": "hero-alt",
                    "block_path": [0, 2],
                    "field": "alt",
                    "fallback": ""
                }
            ]
        },
        {
            "id": "footer",
            "role": "shared-part",
            "shared_part": {
                "title": "Footer",
                "slug": "footer",
